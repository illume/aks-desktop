{
  "name": "aks-desktop",
  "version": "0.9.0",
  "description": "AKS Headlamp plugin",
  "scripts": {
    "start": "headlamp-plugin start",
    "build": "headlamp-plugin build",
    "format": "headlamp-plugin format",
    "lint": "headlamp-plugin lint",
    "lint-fix": "headlamp-plugin lint --fix",
    "package": "headlamp-plugin package",
    "tsc": "headlamp-plugin tsc",
    "storybook": "headlamp-plugin storybook",
    "storybook-build": "headlamp-plugin storybook-build",
    "test": "vitest run -c vitest.config.ts",
    "test:unit": "vitest run -c vitest.config.ts --project unit",
    "test:a11y": "vitest run -c vitest.config.ts --project a11y",
    "test:coverage": "vitest run -c vitest.config.ts --coverage",
    "prettier": "prettier --write .",
    "i18n": "headlamp-plugin i18n"
  },
  "keywords": [
    "headlamp",
    "aks-headlamp-plugin",
    "kubernetes",
    "kubernetes-ui",
    "kubernetes-debugging",
    "plugins"
  ],
  "prettier": "@headlamp-k8s/eslint-config/prettier-config",
  "eslintConfig": {
    "extends": [
      "@headlamp-k8s",
      "prettier",
      "plugin:jsx-a11y/recommended"
    ],
    "plugins": [
      "no-barrel-files"
    ],
    "rules": {
      "no-barrel-files/no-barrel-files": "error"
    }
  },
  "overrides": {
    "typescript": "5.6.2",
    "react": "^18.3.1",
    "react-redux": "^9.1.0"
  },
  "devDependencies": {
    "@guidepup/virtual-screen-reader": "^0.32.1",
    "@kinvolk/headlamp-plugin": "^0.13.1",
    "@testing-library/react": "^16.3.2",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/react": "^19.2.0",
    "@vitest/coverage-istanbul": "^3.2.4",
    "eslint-plugin-no-barrel-files": "^1.2.2",
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.52.4",
    "@rollup/rollup-darwin-x64": "^4.52.4",
    "@rollup/rollup-linux-arm64": "^4.50.1",
    "@rollup/rollup-linux-arm64-musl": "^4.52.4",
    "@rollup/rollup-linux-x64": "^4.50.1",
    "@rollup/rollup-linux-x64-musl": "^4.52.3",
    "@rollup/rollup-win32-arm64": "^4.50.1",
    "@rollup/rollup-win32-x64": "^4.50.1",
    "husky": "^9.0.0"
  },
  "dependencies": {
    "@azure/arm-resourcegraph": "^4.2.1",
    "@azure/arm-subscriptions": "^5.1.0",
    "@azure/identity": "^4.12.0",
    "@microsoft/applicationinsights-web": "^3.4.1",
    "@octokit/rest": "^22.0.0",
    "libsodium-wrappers": "^0.8.2",
    "recharts": "^3.1.2",
    "yaml": "^2.8.3"
  },
  "headlamp": {
    "clusterProviders": [
      "aks-desktop.cluster"
    ],
    "enabledByDefault": true,
    "i18n": [
      "en",
      "de",
      "es",
      "fr",
      "it",
      "ja",
      "id",
      "ko",
      "pt-BR",
      "ru",
      "zh-Hans",
      "zh-Hant",
      "cs",
      "nl",
      "hu",
      "pt-PT",
      "pl",
      "sv",
      "tr"
    ],
    "runCommands": [
      {
        "command": "az",
        "args": [
          "account",
          "get-access-token"
        ]
      },
      {
        "command": "az",
        "args": [
          "account",
          "list"
        ]
      },
      {
        "command": "az",
        "args": [
          "account",
          "list-locations"
        ]
      },
      {
        "command": "az",
        "args": [
          "account",
          "show"
        ]
      },
      {
        "command": "az",
        "args": [
          "account",
          "tenant"
        ]
      },
      {
        "command": "az",
        "args": [
          "acr",
          "create"
        ]
      },
      {
        "command": "az",
        "args": [
          "acr",
          "list"
        ]
      },
      {
        "command": "az",
        "args": [
          "acr",
          "repository"
        ]
      },
      {
        "command": "az",
        "args": [
          "ad",
          "user"
        ]
      },
      {
        "command": "az",
        "args": [
          "aks",
          "get-credentials"
        ]
      },
      {
        "command": "az",
        "args": [
          "aks",
          "list"
        ]
      },
      {
        "command": "az",
        "args": [
          "aks",
          "namespace"
        ]
      },
      {
        "command": "az",
        "args": [
          "aks",
          "show"
        ]
      },
      {
        "command": "az",
        "args": [
          "aks",
          "update"
        ]
      },
      {
        "command": "az",
        "args": [
          "config",
          "set"
        ]
      },
      {
        "command": "az",
        "args": [
          "extension",
          "add"
        ]
      },
      {
        "command": "az",
        "args": [
          "extension",
          "show"
        ]
      },
      {
        "command": "az",
        "args": [
          "feature",
          "show"
        ]
      },
      {
        "command": "az",
        "args": [
          "graph",
          "query"
        ]
      },
      {
        "command": "az",
        "args": [
          "group",
          "create"
        ]
      },
      {
        "command": "az",
        "args": [
          "group",
          "exists"
        ]
      },
      {
        "command": "az",
        "args": [
          "group",
          "list"
        ]
      },
      {
        "command": "az",
        "args": [
          "group",
          "show"
        ]
      },
      {
        "command": "az",
        "args": [
          "identity",
          "create"
        ]
      },
      {
        "command": "az",
        "args": [
          "identity",
          "federated-credential"
        ]
      },
      {
        "command": "az",
        "args": [
          "identity",
          "list"
        ]
      },
      {
        "command": "az",
        "args": [
          "identity",
          "show"
        ]
      },
      {
        "command": "az",
        "args": [
          "login"
        ]
      },
      {
        "command": "az",
        "args": [
          "logout"
        ]
      },
      {
        "command": "az",
        "args": [
          "role",
          "assignment"
        ]
      },
      {
        "command": "az",
        "args": [
          "version"
        ]
      },
      {
        "command": "az",
        "args": [
          "vm",
          "list-sizes"
        ]
      },
      {
        "command": "kubectl",
        "args": [
          "config",
          "current-context"
        ]
      },
      {
        "command": "kubelogin",
        "args": [
          "convert-kubeconfig"
        ]
      }
    ]
  }
}
