+
+import { getProductName } from './getProductInfo';
+
+export function getDocumentTitle(
+  cluster: string | null | undefined,
+  title: string | null | undefined,
+  productName = getProductName() || 'Headlamp'
+) {
+  return [cluster, title, productName].filter(Boolean).join(' - ');
+}
