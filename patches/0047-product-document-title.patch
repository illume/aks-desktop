+import { describe, expect, it } from 'vitest';
+import { getDocumentTitle } from './getDocumentTitle';
+
+describe('getDocumentTitle', () => {
+  it('includes cluster, route, and product names', () => {
+    expect(getDocumentTitle('cluster-a', 'Workloads', 'AKS Desktop')).toBe(
+      'cluster-a - Workloads - AKS Desktop'
+    );
+  });
+
+  it('uses the product name when route context is unavailable', () => {
+    expect(getDocumentTitle(undefined, undefined, 'AKS Desktop')).toBe('AKS Desktop');
+  });
+});
