+import { describe, expect, it } from 'vitest';
+import { isUpdateCheckEnabled, readUpdateCheckSetting } from './update-check';
+
+describe('isUpdateCheckEnabled', () => {
+  it('enables update checks by default', () => {
+    expect(isUpdateCheckEnabled({}, {})).toBe(true);
+  });
+
+  it('uses the environment setting when product metadata omits the setting', () => {
+    expect(isUpdateCheckEnabled({}, { HEADLAMP_CHECK_FOR_UPDATES: 'false' })).toBe(false);
+  });
+
+  it('prefers packaged product metadata over the environment', () => {
+    expect(
+      isUpdateCheckEnabled({ checkForUpdates: false }, { HEADLAMP_CHECK_FOR_UPDATES: 'true' })
+    ).toBe(false);
+  });
+});
+
+describe('readUpdateCheckSetting', () => {
+  it('falls back to the environment when the manifest cannot be read', () => {
+    expect(
+      readUpdateCheckSetting('/path/that/does/not/exist', {
+        HEADLAMP_CHECK_FOR_UPDATES: 'false',
+      })
+    ).toBe(false);
+  });
+});
