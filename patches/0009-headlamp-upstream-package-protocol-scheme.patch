From: gambtho <Thomas.Gamble@microsoft.com>
Date: Fri, 31 Jul 2026 18:58:03 +0000
Subject: [PATCH] app: read the custom protocol from product metadata

---
 app/electron/main.ts          | 14 ++++++++++
 app/electron/protocol.test.ts | 52 +++++++++++++++++++++++++++++++++++
 app/electron/protocol.ts      | 47 +++++++++++++++++++++++++++++++
 3 files changed, 113 insertions(+)
 create mode 100644 app/electron/protocol.test.ts
 create mode 100644 app/electron/protocol.ts

diff --git a/app/electron/main.ts b/app/electron/main.ts
index a2ac8e598..d92526681 100644
--- a/app/electron/main.ts
+++ b/app/electron/main.ts
@@ -53,6 +53,7 @@ import {
   getPluginBinDirectories,
   PluginManager,
 } from './plugin-management';
+import { isProtocolUrl, readProtocolScheme } from './protocol';
 import {
   addRunCmdConsent,
   environmentOverrides,
@@ -192,6 +193,11 @@ const MAX_PORT_ATTEMPTS = Math.abs(Number(process.env.HEADLAMP_MAX_PORT_ATTEMPTS
 
 const useExternalServer = process.env.EXTERNAL_SERVER || false;
 const shouldCheckForUpdates = process.env.HEADLAMP_CHECK_FOR_UPDATES !== 'false';
+const productManifestPath = path.join(
+  isDev ? path.resolve('./') : process.resourcesPath,
+  'app-build-manifest.json'
+);
+const protocolScheme = readProtocolScheme(productManifestPath);
 
 // make it global so that it doesn't get garbage collected
 let mainWindow: BrowserWindow | null;
@@ -1717,6 +1723,13 @@ function startElectron() {
         );
         return;
       }
+      if (!isProtocolUrl(url, protocolScheme)) {
+        dialog.showErrorBox(
+          i18n.t('Invalid URL'),
+          i18n.t('Application opened with an invalid URL: {{ url }}', { url })
+        );
+        return;
+      }
 
       const urlParam = urlObj.hostname;
       let baseUrl = startUrl;
@@ -1737,6 +1750,7 @@ function startElectron() {
       mainWindow?.webContents.send('appConfig', {
         checkForUpdates: shouldCheckForUpdates,
         appVersion,
+        protocolScheme,
       });
     });
 
