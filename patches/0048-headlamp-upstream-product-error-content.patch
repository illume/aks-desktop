+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+export interface ProductErrorContent {
+  title?: string;
+  graphic?: string;
+}
+
+function nonEmpty(value: unknown): string | undefined {
+  return typeof value === 'string' && value.trim() ? value.trim() : undefined;
+}
+
+/**
+ * Returns optional distribution-owned error content supplied at build time.
+ *
+ * Product strings are intentionally not passed through Headlamp's translation
+ * catalog; distributions own their text and localized assets.
+ */
+export function getProductErrorContent(
+  page: 'error' | 'notFound',
+  env: Record<string, unknown> = import.meta.env
+): ProductErrorContent {
+  const prefix =
+    page === 'error' ? 'REACT_APP_HEADLAMP_ERROR_PAGE' : 'REACT_APP_HEADLAMP_NOT_FOUND_PAGE';
+
+  return {
+    title: nonEmpty(env[`${prefix}_TITLE`]),
+    graphic: nonEmpty(env[`${prefix}_GRAPHIC`]),
+  };
+}
