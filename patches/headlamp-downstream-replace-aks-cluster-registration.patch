+
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+type ProviderHandler = (request: Record<string, unknown>) => unknown;
+type RegisterClusterProvider = (provider: string, handler: ProviderHandler) => () => void;
+
+const { registerAKSClusterMock, registerClusterProviderMock } = vi.hoisted(() => ({
+  registerAKSClusterMock: vi.fn(),
+  registerClusterProviderMock: vi.fn<RegisterClusterProvider>(() => vi.fn()),
+}));
+
+vi.mock('./aks-cluster', () => ({ registerAKSCluster: registerAKSClusterMock }));
+vi.mock('./cluster-provider', () => ({ registerClusterProvider: registerClusterProviderMock }));
+
+import { registerAKSClusterProvider } from './aks-cluster-provider';
+
+describe('registerAKSClusterProvider', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+  });
+
+  function providerHandler(): ProviderHandler {
+    registerAKSClusterProvider(new Map([['azure-cli', '/verified/az']]));
+    const registration = registerClusterProviderMock.mock.calls.at(-1);
+    if (!registration) {
+      throw new Error('Cluster provider was not registered');
+    }
+    return registration[1];
+  }
+
+  it('registers an AKS-owned host provider', () => {
+    registerAKSClusterProvider(new Map());
+
+    expect(registerClusterProviderMock).toHaveBeenCalledWith(
+      'aks-desktop.cluster',
+      expect.any(Function)
+    );
+  });
+
+  it('maps named AKS Arc parameters without positional ambiguity', async () => {
+    registerAKSClusterMock.mockResolvedValue({ success: true, message: 'registered' });
+    const handler = providerHandler();
+
+    await expect(
+      handler({
+        subscriptionId: 'subscription',
+        resourceGroup: 'group',
+        clusterName: 'cluster',
+        managedNamespace: 'namespace',
+        clusterType: 'aksarc',
+      })
+    ).resolves.toEqual({ success: true, message: 'registered' });
+    expect(registerAKSClusterMock).toHaveBeenCalledWith(
+      'subscription',
+      'group',
+      'cluster',
+      false,
+      new Map([['azure-cli', '/verified/az']]),
+      'namespace',
+      'aksarc'
+    );
+  });
+
+  it.each([
+    {},
+    { subscriptionId: '', resourceGroup: 'group', clusterName: 'cluster' },
+    { subscriptionId: '-option', resourceGroup: 'group', clusterName: 'cluster' },
+    {
+      subscriptionId: 'subscription',
+      resourceGroup: 'group',
+      clusterName: 'cluster',
+      clusterType: 'tenant-id',
+    },
+    {
+      subscriptionId: 'subscription',
+      resourceGroup: 'group',
+      clusterName: 'cluster',
+      unexpected: true,
+    },
+  ])('rejects an invalid provider request: %j', request => {
+    expect(providerHandler()(request)).toEqual({
+      success: false,
+      message: 'Invalid AKS cluster registration request',
+    });
+    expect(registerAKSClusterMock).not.toHaveBeenCalled();
+  });
+
+  it('replaces the prior registration when the window is recreated', () => {
+    const unregister = vi.fn();
+    registerClusterProviderMock.mockReturnValue(unregister);
+
+    registerAKSClusterProvider(new Map());
+    registerAKSClusterProvider(new Map());
+
+    expect(unregister).toHaveBeenCalledOnce();
+  });
+});
