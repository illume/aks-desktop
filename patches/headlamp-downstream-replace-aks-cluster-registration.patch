+// Portions (c) Microsoft Corp.
+
+import { registerAKSCluster } from './aks-cluster';
+import { registerClusterProvider } from './cluster-provider';
+
+interface AKSClusterRequest {
+  subscriptionId: string;
+  resourceGroup: string;
+  clusterName: string;
+  managedNamespace?: string;
+  clusterType?: 'aks' | 'aksarc';
+}
+
+const MAX_VALUE_LENGTH = 2048;
+
+function validValue(value: unknown): value is string {
+  return (
+    typeof value === 'string' &&
+    value.trim().length > 0 &&
+    value.length <= MAX_VALUE_LENGTH &&
+    !value.includes('\0') &&
+    !value.startsWith('-')
+  );
+}
+
+function validRequest(
+  request: Record<string, unknown>
+): request is Record<string, unknown> & AKSClusterRequest {
+  const allowedKeys = new Set([
+    'subscriptionId',
+    'resourceGroup',
+    'clusterName',
+    'managedNamespace',
+    'clusterType',
+  ]);
+  return (
+    Object.keys(request).every(key => allowedKeys.has(key)) &&
+    validValue(request.subscriptionId) &&
+    validValue(request.resourceGroup) &&
+    validValue(request.clusterName) &&
+    (request.managedNamespace === undefined || validValue(request.managedNamespace)) &&
+    (request.clusterType === undefined ||
+      request.clusterType === 'aks' ||
+      request.clusterType === 'aksarc')
+  );
+}
+
+export function registerAKSClusterProvider(externalTools: ReadonlyMap<string, string>): () => void {
+  unregisterAKSClusterProvider?.();
+  const unregister = registerClusterProvider('aks-desktop.cluster', request => {
+    if (!validRequest(request)) {
+      return { success: false, message: 'Invalid AKS cluster registration request' };
+    }
+    return registerAKSCluster(
+      request.subscriptionId,
+      request.resourceGroup,
+      request.clusterName,
+      false,
+      externalTools,
+      request.managedNamespace,
+      request.clusterType
+    );
+  });
+  unregisterAKSClusterProvider = unregister;
+  return () => {
+    if (unregisterAKSClusterProvider === unregister) {
+      unregister();
+      unregisterAKSClusterProvider = null;
+    }
+  };
+}
+
+let unregisterAKSClusterProvider: (() => void) | null = null;
