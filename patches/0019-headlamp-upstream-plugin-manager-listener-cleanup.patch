Date: Thu, 12 Mar 2026 06:09:43 -0400
Subject: [PATCH] frontend: unsubscribe plugin manager listeners

---
 .../src/components/App/pluginManager.test.ts  | 84 +++++++++++++++++++
 frontend/src/components/App/pluginManager.ts  | 10 +--
 2 files changed, 89 insertions(+), 5 deletions(-)
 create mode 100644 frontend/src/components/App/pluginManager.test.ts

diff --git a/frontend/src/components/App/pluginManager.test.ts b/frontend/src/components/App/pluginManager.test.ts
new file mode 100644
index 000000000..3c881f9d3
--- /dev/null
+++ b/frontend/src/components/App/pluginManager.test.ts
@@ -0,0 +1,84 @@
+/*
