From 3927ae61711b7118158946631b0179d18191782d Mon Sep 17 00:00:00 2001
From: Oleksandr Dubenko <oldubenko@microsoft.com>
Date: Fri, 31 Jul 2026 17:13:49 +0000
Subject: [PATCH] backend: make the application name configurable

---
 backend/cmd/server.go             |  2 ++
 backend/pkg/config/config.go      |  2 ++
 backend/pkg/config/config_test.go | 10 ++++++++++
 3 files changed, 14 insertions(+)

diff --git a/backend/cmd/server.go b/backend/cmd/server.go
index 4df52c83d..0c77d2477 100644
--- a/backend/cmd/server.go
+++ b/backend/cmd/server.go
@@ -58,6 +58,8 @@ func main() {
 
 	logger.Init(conf.LogLevel)
 
+	kubeconfig.AppName = conf.AppName
+
 	if conf.Version {
 		fmt.Printf("%s %s (%s/%s)\n", kubeconfig.AppName, kubeconfig.Version, runtime.GOOS, runtime.GOARCH)
 		return
diff --git a/backend/pkg/config/config.go b/backend/pkg/config/config.go
index 05f716e17..18da57e3a 100644
--- a/backend/pkg/config/config.go
+++ b/backend/pkg/config/config.go
@@ -37,6 +37,7 @@ const (
 
 type Config struct {
 	Version              bool   `koanf:"version"`
+	AppName              string `koanf:"app-name"`
 	InCluster            bool   `koanf:"in-cluster"`
 	InClusterContextName string `koanf:"in-cluster-context-name"`
 	DevMode              bool   `koanf:"dev"`
@@ -540,6 +541,7 @@ func flagset() *flag.FlagSet {
 
 func addGeneralFlags(f *flag.FlagSet) {
 	f.Bool("version", false, "Print version information and exit")
+	f.String("app-name", "Headlamp", "Application name used in version output and Kubernetes User-Agent headers")
 	f.Bool("in-cluster", false, "Set when running from a k8s cluster")
 	f.String("in-cluster-context-name", "",
 		"Name to use for the in-cluster Kubernetes context. "+
diff --git a/backend/pkg/config/config_test.go b/backend/pkg/config/config_test.go
index 70de6b0b6..fd8185ef8 100644
--- a/backend/pkg/config/config_test.go
+++ b/backend/pkg/config/config_test.go
@@ -132,6 +132,16 @@ func TestParseBasic(t *testing.T) {
 	}
 }
 
+func TestParseAppName(t *testing.T) {
+	conf, err := config.Parse(nil)
+	require.NoError(t, err)
+	assert.Equal(t, "Headlamp", conf.AppName)
+
+	conf, err = config.Parse([]string{"headlamp-server", "--app-name=Custom Headlamp"})
+	require.NoError(t, err)
+	assert.Equal(t, "Custom Headlamp", conf.AppName)
+}
+
 var ParseWithEnvTests = []struct {
 	name   string
 	args   []string
-- 
2.54.0
