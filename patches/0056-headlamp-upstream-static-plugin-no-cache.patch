From e97596dc2c8341a03da3ee369239e55ed4cb2ad8 Mon Sep 17 00:00:00 2001
From: Oleksandr Dubenko <oldubenko@microsoft.com>
Date: Fri, 31 Jul 2026 13:40:14 +0000
Subject: [PATCH] backend: disable local static plugin caching

---
 backend/cmd/headlamp.go           |  5 +++
 backend/cmd/plugin_routes_test.go | 67 +++++++++++++++++++++++++++++++
 2 files changed, 72 insertions(+)
 create mode 100644 backend/cmd/plugin_routes_test.go

diff --git a/backend/cmd/headlamp.go b/backend/cmd/headlamp.go
index 1ae3236f4..cf1f6f5a4 100644
--- a/backend/cmd/headlamp.go
+++ b/backend/cmd/headlamp.go
@@ -374,6 +374,11 @@ func addPluginRoutes(config *HeadlampConfig, r *mux.Router) {
 	if config.StaticPluginDir != "" {
 		staticPluginsHandler := http.StripPrefix(config.BaseURL+"/static-plugins/",
 			spa.BrotliSidecars(config.StaticPluginDir, http.FileServer(http.Dir(config.StaticPluginDir))))
+
+		if !config.UseInCluster {
+			staticPluginsHandler = serveWithNoCacheHeader(staticPluginsHandler)
+		}
+
 		r.PathPrefix("/static-plugins/").Handler(staticPluginsHandler)
 	}
 }
diff --git a/backend/cmd/plugin_routes_test.go b/backend/cmd/plugin_routes_test.go
new file mode 100644
index 000000000..c6e6a5d84
--- /dev/null
+++ b/backend/cmd/plugin_routes_test.go
@@ -0,0 +1,67 @@
