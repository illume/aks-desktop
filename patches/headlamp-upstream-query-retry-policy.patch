From ace90b431e1fdfd1eef39274e0830e09a5b6477a Mon Sep 17 00:00:00 2001
From: Oleksandr Dubenko <oldubenko@microsoft.com>
Date: Fri, 21 Nov 2025 11:08:55 -0500
Subject: [PATCH] frontend: avoid retrying permanent HTTP errors

---
 frontend/src/lib/queryClient.test.ts | 34 ++++++++++++++++++++++++++++
 frontend/src/lib/queryClient.ts      | 12 ++++++++++
 2 files changed, 46 insertions(+)
 create mode 100644 frontend/src/lib/queryClient.test.ts

diff --git a/frontend/src/lib/queryClient.test.ts b/frontend/src/lib/queryClient.test.ts
new file mode 100644
index 000000000..452e829ac
--- /dev/null
+++ b/frontend/src/lib/queryClient.test.ts
@@ -0,0 +1,34 @@
+/*
