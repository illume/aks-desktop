+import { render, waitFor } from '@testing-library/react';
+import { KubeObject } from '../../../lib/k8s/cluster';
+import ViewButton from './ViewButton';
+
+const { mockActivityLaunch, mockFetchLatestKubeObject } = vi.hoisted(() => ({
+  mockActivityLaunch: vi.fn(),
+  mockFetchLatestKubeObject: vi.fn(),
+}));
+
+vi.mock('../../activity/Activity', () => ({
+  Activity: {
+    close: vi.fn(),
+    launch: (...args: unknown[]) => mockActivityLaunch(...args),
+  },
+}));
+
+vi.mock('./fetchLatestKubeObject', () => ({
+  fetchLatestKubeObject: (...args: unknown[]) => mockFetchLatestKubeObject(...args),
+}));
+
+vi.mock('../ActionButton', () => ({
+  default: ({ onClick }: { onClick: () => void }) => <button onClick={onClick}>View</button>,
+}));
+
+vi.mock('./EditorDialog', () => ({
+  default: () => null,
+}));
+
+vi.mock('@iconify/react', () => ({
+  Icon: () => null,
+}));
+
+describe('ViewButton', () => {
+  it('opens the resource beside the current content', async () => {
+    const item = {
+      cluster: 'test-cluster',
+      jsonData: {},
+      kind: 'Pod',
+      metadata: { name: 'test-pod', uid: 'test-uid' },
+    } as KubeObject;
+    mockFetchLatestKubeObject.mockResolvedValue(item);
+
+    render(<ViewButton item={item} initialToggle />);
+
+    await waitFor(() =>
+      expect(mockActivityLaunch).toHaveBeenCalledWith(
+        expect.objectContaining({ location: 'split-right' })
+      )
+    );
+  });
+});
