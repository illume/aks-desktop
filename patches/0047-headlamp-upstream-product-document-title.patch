From 172b8349f0dd66c6254f85c826664bf08f59b5f3 Mon Sep 17 00:00:00 2001
From: Oleksandr Dubenko <oldubenko@microsoft.com>
Date: Fri, 31 Jul 2026 17:58:25 +0000
Subject: [PATCH] frontend: include product metadata in document titles

---
 frontend/src/components/App/RouteSwitcher.tsx |  8 ++---
 frontend/src/helpers/getDocumentTitle.test.ts | 30 +++++++++++++++++++
 frontend/src/helpers/getDocumentTitle.ts      | 25 ++++++++++++++++
 3 files changed, 57 insertions(+), 6 deletions(-)
 create mode 100644 frontend/src/helpers/getDocumentTitle.test.ts
 create mode 100644 frontend/src/helpers/getDocumentTitle.ts

diff --git a/frontend/src/components/App/RouteSwitcher.tsx b/frontend/src/components/App/RouteSwitcher.tsx
index 0e69b0a50..3f7cc9cbc 100644
--- a/frontend/src/components/App/RouteSwitcher.tsx
+++ b/frontend/src/components/App/RouteSwitcher.tsx
@@ -19,6 +19,7 @@ import React, { Suspense } from 'react';
 import { useTranslation } from 'react-i18next';
 import { useDispatch } from 'react-redux';
 import { Redirect, Route, RouteProps, Switch, useHistory } from 'react-router-dom';
+import { getDocumentTitle } from '../../helpers/getDocumentTitle';
 import { getCluster, getSelectedClusters } from '../../lib/cluster';
 import { useCluster, useClustersConf } from '../../lib/k8s';
 import { testAuth } from '../../lib/k8s/api/v1/clusterApi';
@@ -135,12 +136,7 @@ function PageTitle({
   const cluster = useCluster();
 
   React.useEffect(() => {
-    if (cluster && title) {
-      document.title = `${cluster} - ${title}`;
-      return;
-    }
-
-    document.title = cluster || title || '';
+    document.title = getDocumentTitle(cluster, title);
   }, [cluster, title]);
 
   return <>{children}</>;
diff --git a/frontend/src/helpers/getDocumentTitle.test.ts b/frontend/src/helpers/getDocumentTitle.test.ts
new file mode 100644
index 000000000..895dab19c
--- /dev/null
+++ b/frontend/src/helpers/getDocumentTitle.test.ts
@@ -0,0 +1,30 @@
