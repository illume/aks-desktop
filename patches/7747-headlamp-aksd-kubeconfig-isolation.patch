From 353ceee01e01680e34888e4612a12a081db797a0 Mon Sep 17 00:00:00 2001
From: Copilot <198982749+Copilot@users.noreply.github.com>
Date: Wed, 7 Oct 2026 22:11:30 +0000
Subject: [PATCH] aksd: backend: prevent shared kubeconfig fallback

---
 backend/pkg/config/config.go      |  8 +-------
 backend/pkg/config/config_test.go | 19 +++++++------------
 2 files changed, 8 insertions(+), 19 deletions(-)

diff --git a/backend/pkg/config/config.go b/backend/pkg/config/config.go
index b53aed9..6d1b69c 100644
--- a/backend/pkg/config/config.go
+++ b/backend/pkg/config/config.go
@@ -527,13 +527,7 @@ func MakeKubeConfigsDir(kubeConfigDir string) (string, error) {
 		}
 	}
 
-	// if any error occurred, fallback to the current directory.
-	ex, err := os.Executable()
-	if err == nil {
-		return filepath.Dir(ex), nil
-	}
-
-	return "", fmt.Errorf("failed to get default kubeconfig persistence directory: %w", err)
+	return "", fmt.Errorf("failed to create default kubeconfig persistence directory: %w", err)
 }
 
 // makeConfiguredKubeConfigsDir creates and returns the configured kubeconfig directory.
diff --git a/backend/pkg/config/config_test.go b/backend/pkg/config/config_test.go
index bd6fd23..70ae2f2 100644
--- a/backend/pkg/config/config_test.go
+++ b/backend/pkg/config/config_test.go
@@ -1101,20 +1101,15 @@ func TestMakeKubeConfigsDir(t *testing.T) {
 		assert.Contains(t, dir, filepath.Join("Headlamp", "kubeconfigs"))
 	})
 
-	t.Run("falls back to the executable directory", func(t *testing.T) {
-		if runtime.GOOS == "windows" {
-			t.Skip("UserConfigDir uses a Windows API instead of an environment variable")
-		}
-
-		setUserConfigDir(t, "")
-		t.Setenv("HOME", "")
+	t.Run("does not fall back to the executable directory", func(t *testing.T) {
+		configPath := filepath.Join(t.TempDir(), "config-file")
+		require.NoError(t, os.WriteFile(configPath, nil, 0o600))
+		setUserConfigDir(t, configPath)
 
 		dir, err := config.MakeKubeConfigsDir("")
-		require.NoError(t, err)
-
-		executable, err := os.Executable()
-		require.NoError(t, err)
-		assert.Equal(t, filepath.Dir(executable), dir)
+		require.Error(t, err)
+		assert.Empty(t, dir)
+		assert.Contains(t, err.Error(), "failed to create default kubeconfig persistence directory")
 	})
 
 	t.Run("reports configured directory creation errors", func(t *testing.T) {
