diff --git a/app/electron/secure-storage.test.ts b/app/electron/secure-storage.test.ts
new file mode 100644
index 0000000..e4145c9
--- /dev/null
+++ b/app/electron/secure-storage.test.ts
@@ -0,0 +1,147 @@
