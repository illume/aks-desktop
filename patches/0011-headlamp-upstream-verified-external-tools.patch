+import crypto from 'node:crypto';
+import fs from 'node:fs';
+import path from 'node:path';
+
+const VALID_TOOL_ID = /^[a-z0-9][a-z0-9._-]*$/i;
+const VALID_SHA256 = /^[a-f0-9]{64}$/;
+const MAX_TOOL_ID_LENGTH = 128;
+const MAX_TOOLS = 64;
+
+interface ExternalToolPlatform {
+  path: string;
+  sha256: string;
+}
+
+interface ExternalToolDeclaration {
+  id: string;
+  platforms: Partial<Record<NodeJS.Platform, ExternalToolPlatform>>;
+}
+
+function isWithin(basePath: string, candidatePath: string): boolean {
+  const relativePath = path.relative(basePath, candidatePath);
+  return (
+    relativePath !== '' &&
+    !relativePath.startsWith(`..${path.sep}`) &&
+    !path.isAbsolute(relativePath)
+  );
+}
+
+function isExternalToolPlatform(value: unknown): value is ExternalToolPlatform {
+  if (typeof value !== 'object' || value === null) {
+    return false;
+  }
+  const platform = value as Partial<ExternalToolPlatform>;
+  return (
+    typeof platform.path === 'string' &&
+    platform.path.length > 0 &&
+    !platform.path.includes('\0') &&
+    !path.isAbsolute(platform.path) &&
+    typeof platform.sha256 === 'string' &&
+    VALID_SHA256.test(platform.sha256)
+  );
+}
+
+function isExternalToolDeclaration(value: unknown): value is ExternalToolDeclaration {
+  if (typeof value !== 'object' || value === null) {
+    return false;
+  }
+  const declaration = value as Partial<ExternalToolDeclaration>;
+  return (
+    typeof declaration.id === 'string' &&
+    declaration.id.length <= MAX_TOOL_ID_LENGTH &&
+    VALID_TOOL_ID.test(declaration.id) &&
+    typeof declaration.platforms === 'object' &&
+    declaration.platforms !== null
+  );
+}
+
+export function resolveExternalTools(
+  manifest: unknown,
+  resourcesPath: string,
+  platform: NodeJS.Platform = process.platform
+): Map<string, string> {
+  const tools = new Map<string, string>();
+  if (typeof manifest !== 'object' || manifest === null) {
+    return tools;
+  }
+  const declarations = (manifest as { 'external-tools'?: unknown })['external-tools'];
+  if (!Array.isArray(declarations) || declarations.length > MAX_TOOLS) {
+    return tools;
+  }
+
+  let realResourcesPath: string;
+  try {
+    realResourcesPath = fs.realpathSync(resourcesPath);
+  } catch {
+    return tools;
+  }
+
+  for (const declaration of declarations) {
+    if (!isExternalToolDeclaration(declaration) || tools.has(declaration.id)) {
+      continue;
+    }
+    const platformEntry = declaration.platforms[platform];
+    if (!isExternalToolPlatform(platformEntry)) {
+      continue;
+    }
+
+    try {
+      const candidatePath = path.resolve(realResourcesPath, platformEntry.path);
+      if (!isWithin(realResourcesPath, candidatePath)) {
+        continue;
+      }
+      const executablePath = fs.realpathSync(candidatePath);
+      if (!isWithin(realResourcesPath, executablePath) || !fs.statSync(executablePath).isFile()) {
+        continue;
+      }
+      const digest = crypto.createHash('sha256').update(fs.readFileSync(executablePath)).digest();
+      const expectedDigest = Buffer.from(platformEntry.sha256, 'hex');
+      if (!crypto.timingSafeEqual(digest, expectedDigest)) {
+        continue;
+      }
+      tools.set(declaration.id, executablePath);
+    } catch {
+      // Invalid or missing product resources are not exposed to plugins.
+    }
+  }
+
+  return tools;
+}
+
+export function loadExternalTools(
+  manifestPath: string,
+  resourcesPath: string,
+  platform: NodeJS.Platform = process.platform
+): Map<string, string> {
+  try {
+    const manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));
+    return resolveExternalTools(manifest, resourcesPath, platform);
+  } catch {
+    return new Map();
+  }
+}
