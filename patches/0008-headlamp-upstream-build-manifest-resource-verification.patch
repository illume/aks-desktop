From b39b97d8d7f2feaf6e0d335d146ab85132b079c4 Mon Sep 17 00:00:00 2001
From: Joaquim Rocha <joaquim.rocha@microsoft.com>
Date: Sat, 1 Aug 2026 07:32:15 +0000
Subject: [PATCH] upstreamable: verify packaged resources from build manifests

---
 app/electron/build-manifest.test.ts | 47 +++++++++++++++++++++++++++
 app/scripts/after-pack.js           |  9 +++++-
 app/scripts/build-manifest.js       | 49 +++++++++++++++++++++++++++++
 3 files changed, 104 insertions(+), 1 deletion(-)

diff --git a/app/electron/build-manifest.test.ts b/app/electron/build-manifest.test.ts
index 277cc558f..dde530235 100644
--- a/app/electron/build-manifest.test.ts
+++ b/app/electron/build-manifest.test.ts
@@ -31,6 +31,7 @@ const {
   DEFAULT_MANIFEST_FILE,
   loadBuildManifest,
   resolveBuildManifestPath,
+  verifyPackagedResources,
 } = require('../scripts/build-manifest');
 const {
   downloadFile,
@@ -85,6 +86,52 @@ describe('build manifest selection', () => {
   });
 });
 
+describe('packaged resource verification', () => {
+  it('accepts regular files with matching digests', () => {
+    const file = temporaryFile('bundled tool');
+    const directory = path.dirname(file);
+    const digest = crypto.createHash('sha256').update('bundled tool').digest('hex');
+    expect(() =>
+      verifyPackagedResources(
+        directory,
+        { verify: [{ path: 'manifest.json', sha256: digest, platforms: ['mac'] }] },
+        'mas'
+      )
+    ).not.toThrow();
+  });
+
+  it('rejects path traversal and digest mismatches', () => {
+    const file = temporaryFile('bundled tool');
+    const directory = path.dirname(file);
+    expect(() =>
+      verifyPackagedResources(
+        directory,
+        { verify: [{ path: '../tool', sha256: '0'.repeat(64) }] },
+        'linux'
+      )
+    ).toThrow('escapes the resources directory');
+    expect(() =>
+      verifyPackagedResources(
+        directory,
+        { verify: [{ path: 'manifest.json', sha256: '0'.repeat(64) }] },
+        'linux'
+      )
+    ).toThrow('SHA-256 mismatch');
+  });
+
+  it('filters verification by packaged platform', () => {
+    expect(() =>
+      verifyPackagedResources(
+        '/missing',
+        {
+          verify: [{ path: 'tool.exe', sha256: '0'.repeat(64), platforms: ['win'] }],
+        },
+        'darwin'
+      )
+    ).not.toThrow();
+  });
+});
+
 describe('build resources', () => {
   it('resolves common and platform resources relative to the manifest', () => {
     const manifestFile = '/product/build.json';
diff --git a/app/scripts/after-pack.js b/app/scripts/after-pack.js
index c035f3f38..8cff790ea 100644
--- a/app/scripts/after-pack.js
+++ b/app/scripts/after-pack.js
@@ -2,14 +2,21 @@
 
 const fs = require('node:fs');
 const path = require('node:path');
+const { loadBuildManifest, verifyPackagedResources } = require('./build-manifest');
 
 exports.default = async context => {
+  const resourcesDirectory = context.packager?.getResourcesDir
+    ? context.packager.getResourcesDir(context.appOutDir)
+    : path.join(context.appOutDir, 'resources');
+
   if (fs.existsSync('.env')) {
     console.info('Copying .env file to app resources directory!');
     try {
-      fs.copyFileSync('.env', path.join(context.appOutDir, 'resources', '.env'));
+      fs.copyFileSync('.env', path.join(resourcesDirectory, '.env'));
     } catch (err) {
       console.error('Failed to copy .env after pack:', err);
     }
   }
+
+  verifyPackagedResources(resourcesDirectory, loadBuildManifest(), context.electronPlatformName);
 };
diff --git a/app/scripts/build-manifest.js b/app/scripts/build-manifest.js
index 88b083fbe..cdc2ef8aa 100644
--- a/app/scripts/build-manifest.js
+++ b/app/scripts/build-manifest.js
@@ -1,5 +1,6 @@
 'use strict';
 
+const crypto = require('node:crypto');
 const fs = require('node:fs');
 const path = require('node:path');
 
@@ -14,6 +15,53 @@ function loadBuildManifest(manifestFile = resolveBuildManifestPath()) {
   return JSON.parse(fs.readFileSync(manifestFile, 'utf8'));
 }
 
+function verifyPackagedResources(resourcesDirectory, manifest, platform) {
+  const verification = manifest.verify;
+  if (verification === undefined) {
+    return;
+  }
+  if (!Array.isArray(verification)) {
+    throw new Error('Build manifest verify must be an array');
+  }
+
+  const platformName = { darwin: 'mac', mas: 'mac', win32: 'win' }[platform] || platform;
+  const root = path.resolve(resourcesDirectory);
+  for (const [index, entry] of verification.entries()) {
+    if (
+      !entry ||
+      typeof entry.path !== 'string' ||
+      typeof entry.sha256 !== 'string' ||
+      (entry.platforms !== undefined &&
+        (!Array.isArray(entry.platforms) ||
+          entry.platforms.some(value => !['linux', 'mac', 'win'].includes(value))))
+    ) {
+      throw new Error(`Invalid build manifest verify[${index}]`);
+    }
+    if (entry.platforms && !entry.platforms.includes(platformName)) {
+      continue;
+    }
+    if (!/^[a-f0-9]{64}$/i.test(entry.sha256)) {
+      throw new Error(`Invalid SHA-256 for packaged resource ${entry.path}`);
+    }
+
+    const resource = path.resolve(root, entry.path);
+    if (resource !== root && !resource.startsWith(`${root}${path.sep}`)) {
+      throw new Error(`Packaged resource escapes the resources directory: ${entry.path}`);
+    }
+    const stat = fs.lstatSync(resource);
+    if (!stat.isFile() || stat.isSymbolicLink()) {
+      throw new Error(`Packaged resource is not a regular file: ${entry.path}`);
+    }
+    const actualDigest = crypto
+      .createHash('sha256')
+      .update(fs.readFileSync(resource))
+      .digest('hex');
+    if (actualDigest.toLowerCase() !== entry.sha256.toLowerCase()) {
+      throw new Error(`SHA-256 mismatch for packaged resource ${entry.path}`);
+    }
+  }
+}
+
 function applyBuildResources(config, manifest, manifestFile = resolveBuildManifestPath()) {
   const resources = manifest.resources;
   if (resources === undefined) {
@@ -183,4 +231,5 @@ module.exports = {
   DEFAULT_MANIFEST_FILE,
   loadBuildManifest,
   resolveBuildManifestPath,
+  verifyPackagedResources,
 };
