From 9d003d1fe6d3fc4567f6c0c461e9413d55a60ab4 Mon Sep 17 00:00:00 2001
From: tejhan-diallo <tejhan.diallo@gmail.com>
Date: Thu, 12 Mar 2026 06:09:43 -0400
Subject: [PATCH] app: report consent rejection exits

---
 app/electron/runCmd.test.ts | 31 +++++++++++++++++++++++++++----
 app/electron/runCmd.ts      |  1 +
 2 files changed, 28 insertions(+), 4 deletions(-)

diff --git a/app/electron/runCmd.test.ts b/app/electron/runCmd.test.ts
index f9bcb1f9d..1561628d8 100644
--- a/app/electron/runCmd.test.ts
+++ b/app/electron/runCmd.test.ts
@@ -18,8 +18,9 @@ import { EventEmitter } from 'events';
 import path from 'path';
 import { afterEach, beforeEach, describe, expect, it, Mock, vi } from 'vitest';
 
-const { getShellEnvironmentMock, spawnMock } = vi.hoisted(() => ({
+const { getShellEnvironmentMock, loadSettingsMock, spawnMock } = vi.hoisted(() => ({
   getShellEnvironmentMock: vi.fn(),
+  loadSettingsMock: vi.fn(),
   spawnMock: vi.fn(),
 }));
 
@@ -33,9 +34,7 @@ vi.mock('./plugin-management', () => ({
 }));
 
 vi.mock('./settings', () => ({
-  loadSettings: vi.fn(() => ({
-    confirmedCommands: { 'minikube start': true, 'gh auth': true, 'az account': true },
-  })),
+  loadSettings: loadSettingsMock,
   saveSettings: vi.fn(),
   SETTINGS_PATH: '/fake/settings.json',
 }));
@@ -278,6 +277,10 @@ describe('handleRunCommand', () => {
   beforeEach(() => {
     getShellEnvironmentMock.mockReset();
     getShellEnvironmentMock.mockResolvedValue(shellEnvironment);
+    loadSettingsMock.mockReset();
+    loadSettingsMock.mockReturnValue({
+      confirmedCommands: { 'minikube start': true, 'gh auth': true, 'az account': true },
+    });
     spawnMock.mockReset();
     childEmitter = new EventEmitter();
     childEmitter.stdout = new EventEmitter();
@@ -295,6 +298,26 @@ describe('handleRunCommand', () => {
     vi.unstubAllEnvs();
   });
 
+  it('reports an exit when the user denies command consent', async () => {
+    loadSettingsMock.mockReturnValue({ confirmedCommands: { 'gh auth': false } });
+
+    await handleRunCommand(
+      fakeEvent,
+      {
+        id: 'consent-denied',
+        command: 'gh',
+        args: ['auth', 'status'],
+        options: {},
+        permissionSecrets: { 'runCmd-gh': 1 },
+      },
+      { id: 1 } as any,
+      { 'runCmd-gh': 1 }
+    );
+
+    expect(sentMessages).toContainEqual(['command-exit', 'consent-denied', -3]);
+    expect(spawnMock).not.toHaveBeenCalled();
+  });
+
   it('runs gh with the login-shell environment and reports child errors', async () => {
     const fakeMainWindow = { id: 1 } as any;
     const permissionSecrets = { 'runCmd-gh': 99 };
diff --git a/app/electron/runCmd.ts b/app/electron/runCmd.ts
index 3502afe7c..f3c90defb 100644
--- a/app/electron/runCmd.ts
+++ b/app/electron/runCmd.ts
@@ -284,6 +284,7 @@ export async function handleRunCommand(
   }
 
   if (!checkCommandConsent(commandData.command, commandData.args, mainWindow)) {
+    event.sender.send('command-exit', commandData.id, -3);
     return;
   }
 
