From 48e4e03806152cf2aa527147e9a4105150b6b082 Mon Sep 17 00:00:00 2001
From: tejhan-diallo <tejhan.diallo@gmail.com>
Date: Thu, 12 Mar 2026 06:09:43 -0400
Subject: [PATCH] frontend: clean up command listeners on exit

---
 .../src/components/App/runCommand.test.ts     | 68 +++++++++++++++++++
 frontend/src/components/App/runCommand.ts     | 34 ++++++----
 2 files changed, 90 insertions(+), 12 deletions(-)
 create mode 100644 frontend/src/components/App/runCommand.test.ts

diff --git a/frontend/src/components/App/runCommand.test.ts b/frontend/src/components/App/runCommand.test.ts
new file mode 100644
index 000000000..923fa792c
--- /dev/null
+++ b/frontend/src/components/App/runCommand.test.ts
@@ -0,0 +1,68 @@
+/*
