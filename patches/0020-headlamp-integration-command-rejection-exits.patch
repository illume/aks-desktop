From a5ffb7af71bc3a05c708d3370e6872b03b69ccc0 Mon Sep 17 00:00:00 2001
From: tejhan-diallo <tejhan.diallo@gmail.com>
Date: Sat, 1 Aug 2026 12:34:29 +0000
Subject: [PATCH] upstreamable: combine rejected command exit reporting

---
 app/electron/runCmd.test.ts | 57 +++++++++++++++++++++++++++++++++++++
 app/electron/runCmd.ts      |  5 ++++
 2 files changed, 62 insertions(+)

diff --git a/app/electron/runCmd.test.ts b/app/electron/runCmd.test.ts
index 01ebe01..07262c5 100644
--- a/app/electron/runCmd.test.ts
+++ b/app/electron/runCmd.test.ts
@@ -507,6 +507,7 @@ describe('handleRunCommand', () => {
   let sentMessages: Array<[string, ...unknown[]]>;
 
   beforeEach(() => {
+    dialogMock.mockReset();
     getShellEnvironmentMock.mockReset();
     getShellEnvironmentMock.mockResolvedValue(shellEnvironment);
     spawnMock.mockReset();
@@ -526,6 +527,62 @@ describe('handleRunCommand', () => {
     vi.unstubAllEnvs();
   });
 
+  it('reports an exit when command data is invalid', async () => {
+    await handleRunCommand(
+      fakeEvent,
+      {
+        id: 'invalid-command',
+        command: 'not-allowed',
+        args: [],
+        options: {},
+        permissionSecrets: {},
+      },
+      { id: 1 } as any,
+      {}
+    );
+
+    expect(sentMessages).toContainEqual(['command-exit', 'invalid-command', -1]);
+    expect(spawnMock).not.toHaveBeenCalled();
+  });
+
+  it('reports an exit when the permission secret is rejected', async () => {
+    await handleRunCommand(
+      fakeEvent,
+      {
+        id: 'permission-denied',
+        command: 'gh',
+        args: ['auth', 'status'],
+        options: {},
+        permissionSecrets: { 'runCmd-gh': 1 },
+      },
+      { id: 1 } as any,
+      { 'runCmd-gh': 2 }
+    );
+
+    expect(sentMessages).toContainEqual(['command-exit', 'permission-denied', -2]);
+    expect(spawnMock).not.toHaveBeenCalled();
+  });
+
+  it('reports an exit when the user denies command consent', async () => {
+    dialogMock.mockReturnValue(1);
+
+    await handleRunCommand(
+      fakeEvent,
+      {
+        id: 'consent-denied',
+        command: 'minikube',
+        args: ['status'],
+        options: {},
+        permissionSecrets: { 'runCmd-minikube': 1 },
+      },
+      { id: 1 } as any,
+      { 'runCmd-minikube': 1 }
+    );
+
+    expect(sentMessages).toContainEqual(['command-exit', 'consent-denied', -3]);
+    expect(spawnMock).not.toHaveBeenCalled();
+  });
+
   it('runs gh with the login-shell environment and reports child errors', async () => {
     const fakeMainWindow = { id: 1 } as any;
     const permissionSecrets = { 'runCmd-gh': 99 };
diff --git a/app/electron/runCmd.ts b/app/electron/runCmd.ts
index b74d099..3f2e0ac 100644
--- a/app/electron/runCmd.ts
+++ b/app/electron/runCmd.ts
@@ -442,6 +442,9 @@ export async function handleRunCommand(
   const [isValid, errorMessage] = validateCommandData(eventData);
   if (!isValid) {
     console.error(errorMessage);
+    if (typeof eventData?.id === 'string') {
+      event.sender.send('command-exit', eventData.id, -1);
+    }
     return;
   }
   const commandData = eventData as CommandData;
@@ -458,6 +461,7 @@ export async function handleRunCommand(
       : [false, 'Command is outside its declared plugin scope'];
   if (!permissionsValid) {
     console.error(permissionError);
+    event.sender.send('command-exit', commandData.id, -2);
     return;
   }
 
@@ -469,6 +473,7 @@ export async function handleRunCommand(
       commandScope?.pluginName
     )
   ) {
+    event.sender.send('command-exit', commandData.id, -3);
     return;
   }
 
-- 
