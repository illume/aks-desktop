+    const userMinikubeBin = path.join(userPlugins, 'headlamp_minikube', 'bin');
+
+    const environment = sanitizeProxyEnvironment(
+      {
+        HOME: path.join(tmpdir(), 'home'),
+        PATH: [userMinikubeBin, bundledBin, systemBin].join(path.delimiter),
+      },
+      userPlugins
+    );
