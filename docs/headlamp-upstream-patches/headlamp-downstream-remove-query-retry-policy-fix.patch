From: "copilot-swe-agent[bot]" <198982749+Copilot@users.noreply.github.com>
Date: Fri, 31 Jul 2026 16:21:19 +0000
Subject: [PATCH] aksd: drop upstreamed query retry policy

---
 frontend/src/lib/queryClient.ts | 13 -------------
 1 file changed, 13 deletions(-)

diff --git a/frontend/src/lib/queryClient.ts b/frontend/src/lib/queryClient.ts
index c8b924504..2449894b1 100644
--- a/frontend/src/lib/queryClient.ts
+++ b/frontend/src/lib/queryClient.ts
@@ -21,19 +21,6 @@ export const queryClient = new QueryClient({
     queries: {
       staleTime: 3 * 60_000,
       refetchOnWindowFocus: false,
-      retry(failureCount, error: unknown) {
-        // Do not retry for unauthorized or bad requests
-        if (
-          !!error &&
-          typeof error === 'object' &&
-          'status' in error &&
-          !isNaN(Number(error.status)) &&
-          Number(error.status) < 500
-        ) {
-          return false;
-        }
-        return failureCount < 3;
-      },
     },
   },
 });
