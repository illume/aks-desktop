+import { describe, expect, it } from 'vitest';
+import { getProtocolScheme, isProtocolUrl, readProtocolScheme } from './protocol';
+
+describe('getProtocolScheme', () => {
+  it('returns the first configured package protocol', () => {
+    expect(
+      getProtocolScheme({
+        build: {
+          protocols: {
+            schemes: ['My-Desktop', 'unused'],
+          },
+        },
+      })
+    ).toBe('my-desktop');
+  });
+
+  it.each([{}, null, { build: { protocols: { schemes: [] } } }])(
+    'falls back for package configuration without a protocol',
+    packageConfig => {
+      expect(getProtocolScheme(packageConfig)).toBe('headlamp');
+    }
+  );
+
+  it('falls back for an invalid protocol', () => {
+    expect(getProtocolScheme({ build: { protocols: { schemes: ['not a scheme'] } } })).toBe(
+      'headlamp'
+    );
+  });
+});
+
+describe('readProtocolScheme', () => {
+  it('falls back when package metadata cannot be read', () => {
+    expect(readProtocolScheme('/path/that/does/not/exist')).toBe('headlamp');
+  });
+});
+
+describe('isProtocolUrl', () => {
+  it('accepts URLs for the configured protocol', () => {
+    expect(isProtocolUrl('my-desktop://cluster?name=local', 'my-desktop')).toBe(true);
+  });
+
+  it('rejects malformed URLs and other protocols', () => {
+    expect(isProtocolUrl('not a URL', 'my-desktop')).toBe(false);
+    expect(isProtocolUrl('headlamp://cluster', 'my-desktop')).toBe(false);
+  });
+});
diff --git a/app/electron/protocol.ts b/app/electron/protocol.ts
new file mode 100644
index 000000000..ac7d41249
