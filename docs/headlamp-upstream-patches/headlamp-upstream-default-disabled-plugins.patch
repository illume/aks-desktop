From 629471dcf9b3122527f40f9aa029a29f093a9617 Mon Sep 17 00:00:00 2001
From: Joaquim Rocha <joaquim.rocha@microsoft.com>
Date: Fri, 7 Nov 2025 10:10:45 +0000
Subject: [PATCH] app: support default-disabled bundled plugins

---
 app/scripts/setup-plugins.js                  | 14 +++++++-
 frontend/src/plugin/index.ts                  |  3 +-
 frontend/src/plugin/pluginsSlice.ts           | 13 +++++++
 .../src/plugin/updateSettingsPackages.test.ts | 36 +++++++++++++++++++
 4 files changed, 63 insertions(+), 3 deletions(-)

diff --git a/app/scripts/setup-plugins.js b/app/scripts/setup-plugins.js
index 0393bdbef..09ab0312d 100644
--- a/app/scripts/setup-plugins.js
+++ b/app/scripts/setup-plugins.js
@@ -139,7 +139,7 @@ async function main() {
   // Fetch the plugins from the manifest
   if (!!plugins) {
     for (const plugin of plugins) {
-      const { name, archive, file } = plugin;
+      const { name, archive, file, enabledByDefault } = plugin;
 
       console.log('Setting up plugin', name, 'from', archive || file, '...');
 
@@ -151,6 +151,18 @@ async function main() {
         const absPath = path.join(path.dirname(MANIFEST_FILE), file);
         await extractArchive(name, absPath);
       }
+
+      const pluginFolder = path.join(PLUGIN_FOLDER, name);
+      const packageJsonPath = path.join(pluginFolder, 'package.json');
+
+      if (enabledByDefault !== undefined && fs.existsSync(packageJsonPath)) {
+        const packageJson = JSON.parse(fs.readFileSync(packageJsonPath, 'utf8'));
+        packageJson.headlamp = packageJson.headlamp || {};
+        packageJson.headlamp.enabledByDefault = enabledByDefault;
+
+        fs.writeFileSync(packageJsonPath, JSON.stringify(packageJson, null, 2));
+        console.log(`Plugin ${name} enabledByDefault: ${enabledByDefault}`);
+      }
     }
   }
 
diff --git a/frontend/src/plugin/index.ts b/frontend/src/plugin/index.ts
index 0b9e7de81..63c9dec1b 100644
--- a/frontend/src/plugin/index.ts
+++ b/frontend/src/plugin/index.ts
@@ -315,10 +315,9 @@ export function updateSettingsPackages(
     const index = settingsPlugins.findIndex(x => x.name === plugin.name && x.type === plugin.type);
 
     if (index === -1) {
-      // It's a new one settings doesn't know about, enable it by default
       return {
         ...plugin,
-        isEnabled: true,
+        isEnabled: plugin.headlamp?.enabledByDefault ?? true,
       };
     }
 
diff --git a/frontend/src/plugin/pluginsSlice.ts b/frontend/src/plugin/pluginsSlice.ts
index aa894f6bf..36b5efb14 100644
--- a/frontend/src/plugin/pluginsSlice.ts
+++ b/frontend/src/plugin/pluginsSlice.ts
@@ -104,6 +104,19 @@ export type PluginInfo = {
    */
   isCompatible?: boolean;
 
+  /**
+   * headlamp is an object containing Headlamp-specific plugin configuration
+   */
+  headlamp?: {
+    /**
+     * enabledByDefault indicates if this plugin should be enabled by default when first discovered
+     * If not specified, defaults to true
+     */
+    enabledByDefault?: boolean;
+    /** Array of supported locales for i18n */
+    i18n?: string[];
+  };
+
   version?: string; // unused by PluginSettings
   author?: string; // unused by PluginSettings
   /**
diff --git a/frontend/src/plugin/updateSettingsPackages.test.ts b/frontend/src/plugin/updateSettingsPackages.test.ts
index caec99439..bebf47d46 100644
--- a/frontend/src/plugin/updateSettingsPackages.test.ts
+++ b/frontend/src/plugin/updateSettingsPackages.test.ts
@@ -39,6 +39,21 @@ describe('updateSettingsPackages tests', () => {
     expect(updatedSettingsPlugins[0].isEnabled).toBe(true);
   });
 
+  test('when a new backend plugin is disabled by default', () => {
+    const backendPlugins: PluginInfo[] = [
+      {
+        name: 'ourplugin1',
+        description: 'package description1',
+        homepage: 'https://example.com/1',
+        headlamp: { enabledByDefault: false },
+      },
+    ];
+
+    const updatedSettingsPlugins = updateSettingsPackages(backendPlugins, []);
+
+    expect(updatedSettingsPlugins[0].isEnabled).toBe(false);
+  });
+
   test('when there is an existing setting already turned to true by user', () => {
     const backendPlugins: PluginInfo[] = [
       {
@@ -88,4 +103,25 @@ describe('updateSettingsPackages tests', () => {
     const updatedSettingsPlugins = updateSettingsPackages(backendPlugins, settingsPlugins);
     expect(updatedSettingsPlugins.length).toBe(0);
   });
+
+  test('when an existing user choice differs from the plugin default', () => {
+    const backendPlugins: PluginInfo[] = [
+      {
+        name: 'ourplugin1',
+        description: 'package description1',
+        homepage: 'https://example.com/1',
+        headlamp: { enabledByDefault: true },
+      },
+    ];
+    const settingsPlugins: PluginInfo[] = [
+      {
+        ...backendPlugins[0],
+        isEnabled: false,
+      },
+    ];
+
+    const updatedSettingsPlugins = updateSettingsPackages(backendPlugins, settingsPlugins);
+
+    expect(updatedSettingsPlugins[0].isEnabled).toBe(false);
+  });
 });
-- 
