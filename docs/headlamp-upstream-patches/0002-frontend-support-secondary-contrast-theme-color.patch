From f31b3684b450d509d34a9ba4b3a7a6740d10b9af Mon Sep 17 00:00:00 2001
From: tejhan-diallo <tejhan.diallo@gmail.com>
Date: Fri, 31 Jul 2026 13:03:22 +0000
Subject: [PATCH] frontend: support secondary contrast theme color

Signed-off-by: tejhan-diallo <tejhan.diallo@gmail.com>
---
 frontend/src/lib/AppTheme.ts    |  2 ++
 frontend/src/lib/themes.test.ts | 11 +++++++++++
 frontend/src/lib/themes.ts      |  5 ++++-
 3 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/frontend/src/lib/AppTheme.ts b/frontend/src/lib/AppTheme.ts
index 4db982ec7..ca469a2d0 100644
--- a/frontend/src/lib/AppTheme.ts
+++ b/frontend/src/lib/AppTheme.ts
@@ -27,2 +27,4 @@ export interface AppTheme {
   secondary?: string;
+  /** Text color to use against the secondary theme color */
+  secondaryContrastText?: string;
   text?: {
diff --git a/frontend/src/lib/themes.test.ts b/frontend/src/lib/themes.test.ts
index 1eb5d4e3a..2ffd4f75b 100644
--- a/frontend/src/lib/themes.test.ts
+++ b/frontend/src/lib/themes.test.ts
@@ -57,2 +57,13 @@ describe('themes.ts', () => {
     });
+
+    it('should allow secondary contrast text override from AppTheme', () => {
+      const theme = createMuiTheme({
+        base: 'light',
+        name: 'Custom Theme',
+        secondary: '#123456',
+        secondaryContrastText: '#ffffff',
+      });
+
+      expect(theme.palette.secondary.contrastText).toBe('#ffffff');
+    });
   });
diff --git a/frontend/src/lib/themes.ts b/frontend/src/lib/themes.ts
index 173313bcc..08cf85c9f 100644
--- a/frontend/src/lib/themes.ts
+++ b/frontend/src/lib/themes.ts
@@ -225,3 +225,6 @@ export function createMuiTheme(currentTheme: AppTheme) {
       secondary: currentTheme.secondary
-        ? { main: currentTheme.secondary, contrastText: '#000' }
+        ? {
+            main: currentTheme.secondary,
+            contrastText: currentTheme.secondaryContrastText ?? '#000',
+          }
         : {
