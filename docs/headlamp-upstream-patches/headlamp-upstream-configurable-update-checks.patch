+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+import { describe, expect, it } from 'vitest';
+import { isUpdateCheckEnabled } from './update-check';
+
+describe('isUpdateCheckEnabled', () => {
+  it('enables update checks by default', () => {
+    expect(isUpdateCheckEnabled({})).toBe(true);
+  });
+
+  it('disables update checks when explicitly configured', () => {
+    expect(isUpdateCheckEnabled({ HEADLAMP_CHECK_FOR_UPDATES: 'false' })).toBe(false);
+  });
+});
diff --git a/app/electron/update-check.ts b/app/electron/update-check.ts
new file mode 100644
index 000000000..5ded35ea3
--- /dev/null
+++ b/app/electron/update-check.ts
@@ -0,0 +1,19 @@
+/*
