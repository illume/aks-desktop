Subject: [PATCH] app: cover configurable update checks

---
 app/electron/main.ts              |  3 ++-
 app/electron/update-check.test.ts | 28 ++++++++++++++++++++++++++++
 app/electron/update-check.ts      | 19 +++++++++++++++++++
 3 files changed, 49 insertions(+), 1 deletion(-)
 create mode 100644 app/electron/update-check.test.ts
 create mode 100644 app/electron/update-check.ts

diff --git a/app/electron/main.ts b/app/electron/main.ts
index a2ac8e598..28e9f218b 100644
--- a/app/electron/main.ts
+++ b/app/electron/main.ts
@@ -68,6 +68,7 @@ import {
   isTrayIconEnabled,
   setTrayIconEnabled,
 } from './tray';
+import { isUpdateCheckEnabled } from './update-check';
 import windowSize from './windowSize';
 
 if (process.env.APPIMAGE) {
@@ -191,7 +192,7 @@ let actualPort = defaultPort; // Will be updated when backend starts
 const MAX_PORT_ATTEMPTS = Math.abs(Number(process.env.HEADLAMP_MAX_PORT_ATTEMPTS) || 100); // Maximum number of ports to try
 
 const useExternalServer = process.env.EXTERNAL_SERVER || false;
-const shouldCheckForUpdates = process.env.HEADLAMP_CHECK_FOR_UPDATES !== 'false';
+const shouldCheckForUpdates = isUpdateCheckEnabled();
 
 // make it global so that it doesn't get garbage collected
 let mainWindow: BrowserWindow | null;
diff --git a/app/electron/update-check.test.ts b/app/electron/update-check.test.ts
new file mode 100644
index 000000000..baa654c06
--- /dev/null
+++ b/app/electron/update-check.test.ts
@@ -0,0 +1,28 @@
