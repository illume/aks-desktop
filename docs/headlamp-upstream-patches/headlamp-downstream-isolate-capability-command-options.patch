From bb3f88073988b4011a020070640e72c297e43810 Mon Sep 17 00:00:00 2001
From: GitHub Copilot <copilot@github.com>
Date: Sat, 1 Aug 2026 09:39:15 +0000
Subject: [PATCH] aksd: isolate capability command options

---
 app/electron/runCmd.test.ts | 54 +++++++++++++++++++++++++++++++++++++
 app/electron/runCmd.ts      |  3 +++
 2 files changed, 57 insertions(+)

diff --git a/app/electron/runCmd.test.ts b/app/electron/runCmd.test.ts
index a9b6bb463..d3218feea 100644
--- a/app/electron/runCmd.test.ts
+++ b/app/electron/runCmd.test.ts
@@ -181,6 +181,29 @@ describe('plugin command capabilities', () => {
     ).toEqual([false, 'Command is outside its declared plugin scope']);
   });
 
+  it('does not authorize renderer-controlled spawn options', () => {
+    const { capabilities, scopeByCapability } = createCommandCapabilities([
+      {
+        pluginName: '@example/plugin',
+        scopes: [{ command: 'kubectl', args: ['get'] }],
+      },
+    ]);
+
+    expect(
+      checkCommandCapability(
+        {
+          id: '1',
+          command: 'kubectl',
+          args: ['get'],
+          options: { cwd: '/tmp' },
+          permissionSecrets: {},
+          capability: capabilities['@example/plugin'][0].capability,
+        },
+        scopeByCapability
+      )
+    ).toEqual([false, 'Command is outside its declared plugin scope']);
+  });
+
   it('ignores malformed and duplicate scopes', () => {
     const { capabilities } = createCommandCapabilities([
       {
@@ -542,6 +565,37 @@ describe('handleRunCommand - child process error event', () => {
     );
   });
 
+  it('does not spawn a capability-backed command with custom options', async () => {
+    const fakeEvent = {
+      sender: {
+        send: vi.fn(),
+      },
+    } as any;
+    const { capabilities, scopeByCapability } = createCommandCapabilities([
+      {
+        pluginName: '@example/plugin',
+        scopes: [{ command: 'kubectl', args: ['get'] }],
+      },
+    ]);
+
+    await handleRunCommand(
+      fakeEvent,
+      {
+        id: 'declared-command-options',
+        command: 'kubectl',
+        args: ['get'],
+        options: { cwd: '/tmp' },
+        permissionSecrets: {},
+        capability: capabilities['@example/plugin'][0].capability,
+      },
+      { id: 1 } as any,
+      {},
+      scopeByCapability
+    );
+
+    expect(spawnMock).not.toHaveBeenCalled();
+  });
+
   it('resolves a declared tool capability to its verified product path', async () => {
     const childEmitter = new EventEmitter() as any;
     childEmitter.stdout = new EventEmitter();
diff --git a/app/electron/runCmd.ts b/app/electron/runCmd.ts
index 5a3152fbe..6f419379e 100644
--- a/app/electron/runCmd.ts
+++ b/app/electron/runCmd.ts
@@ -178,6 +178,9 @@ function getCommandCapabilityScope(
   commandData: CommandData,
   scopeByCapability: Map<string, RegisteredCommandScope>
 ): RegisteredCommandScope | undefined {
+  if (Array.isArray(commandData.options) || Object.keys(commandData.options).length !== 0) {
+    return undefined;
+  }
   const scope =
     typeof commandData.capability === 'string'
       ? scopeByCapability.get(commandData.capability)
