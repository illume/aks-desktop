+describe('platform metadata', () => {
+  it('overrides only product-facing platform fields', () => {
+    const defaults = { linux: { category: 'Network', productName: 'Headlamp' } };
+    expect(
+      applyPlatformMetadata(defaults, {
+        platforms: { linux: { productName: 'Example Desktop', icon: '/product/icon.png' } },
+      })
+    ).toEqual({
+      linux: {
+        category: 'Network',
+        productName: 'Example Desktop',
+        icon: '/product/icon.png',
+      },
+    });
+  });
+
+  it('rejects arbitrary electron-builder platform settings', () => {
+    expect(() =>
+      applyPlatformMetadata({}, { platforms: { mac: { hardenedRuntime: false } } })
+    ).toThrow('Unsupported build manifest platforms.mac.hardenedRuntime');
+  });
+});
+
