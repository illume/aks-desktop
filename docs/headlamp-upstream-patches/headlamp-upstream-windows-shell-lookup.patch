From 9e58b2a5d519f3645dc591ef74b51e0d83193977 Mon Sep 17 00:00:00 2001
From: Joaquim Rocha <joaquim.rocha@microsoft.com>
Date: Tue, 28 Oct 2025 17:17:29 +0000
Subject: [PATCH] app: skip Unix shell lookup on Windows

---
 app/electron/main.ts | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/app/electron/main.ts b/app/electron/main.ts
index a2ac8e598..85a966989 100644
--- a/app/electron/main.ts
+++ b/app/electron/main.ts
@@ -667,7 +667,6 @@ async function getShell(): Promise<string> {
  */
 async function getShellEnv(): Promise<NodeJS.ProcessEnv> {
   const execPromisify = promisify(exec);
-  const shell = await getShell();
   const isWindows = process.platform === 'win32';
 
   // For Windows, just return the current environment
@@ -675,7 +674,8 @@ async function getShellEnv(): Promise<NodeJS.ProcessEnv> {
     return { ...process.env };
   }
 
-  // For Unix-like systems
+  // For Unix-like systems, get the shell
+  const shell = await getShell();
   const isZsh = shell.includes('zsh');
   // interactive is supported only on zsh
   const shellArgs = isZsh ? ['--login', '--interactive', '-c'] : ['--login', '-c'];
-- 
2.54.0

