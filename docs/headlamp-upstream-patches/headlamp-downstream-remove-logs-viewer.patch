-export const AnsiText = ({ text, searchQuery }: { text: string; searchQuery?: string }) => {
-  const ansiCodes: Record<string, string> = {
-    '1': 'ansi-bold',
-    '3': 'ansi-italic',
-    '4': 'ansi-underline',
-    '30': 'ansi-black-fg',
