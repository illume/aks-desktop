-    const result: ParsedLog[] = [];
-    const addPod = Object.keys(logs).length > 1;
-    Object.entries(logs).forEach(([pod, logs]) => {
-      logs.forEach(log => {
-        result.push(parseLogLine(log, addPod ? pod : undefined));
-      });
-    });
-    return sortBy(result, it => it.timestamp);
-  }, [logs]);
-  return parsed;
-};
