+describe('build resources', () => {
+  it('resolves common and platform resources relative to the manifest', () => {
+    const manifestFile = '/product/build.json';
+    const config = applyBuildResources(
+      { extraResources: [{ from: '/headlamp/frontend' }], mac: {} },
+      {
+        resources: {
+          common: [{ from: './shared', to: 'shared' }],
+          mac: [{ from: './tools/mac', to: 'tools' }],
+        },
+      },
+      manifestFile
+    );
+    expect(config.extraResources).toContainEqual({ from: '/product/shared', to: 'shared' });
+    expect(config.mac.extraResources).toEqual([{ from: '/product/tools/mac', to: 'tools' }]);
+  });
+
+  it('rejects unsupported resource options', () => {
+    expect(() =>
+      applyBuildResources({}, { resources: { common: [{ from: 'tools', unsafe: true }] } })
+    ).toThrow('Invalid build manifest resources.common[0]');
+  });
+});
+
