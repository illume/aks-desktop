diff --git a/app/scripts/build-manifest.js b/app/scripts/build-manifest.js
index 3f6e69d1c..88b083fbe 100644
--- a/app/scripts/build-manifest.js
+++ b/app/scripts/build-manifest.js
@@ -14,6 +14,60 @@ function loadBuildManifest(manifestFile = resolveBuildManifestPath()) {
   return JSON.parse(fs.readFileSync(manifestFile, 'utf8'));
 }
 
+function applyBuildResources(config, manifest, manifestFile = resolveBuildManifestPath()) {
+  const resources = manifest.resources;
+  if (resources === undefined) {
+    return config;
+  }
+  if (!resources || typeof resources !== 'object' || Array.isArray(resources)) {
+    throw new Error('Build manifest resources must be an object');
+  }
+
+  const resolveResources = (entries, group) => {
+    if (!Array.isArray(entries)) {
+      throw new Error(`Build manifest resources.${group} must be an array`);
+    }
+    return entries.map((entry, index) => {
+      if (!entry || typeof entry !== 'object' || Array.isArray(entry)) {
+        throw new Error(`Invalid build manifest resources.${group}[${index}]`);
+      }
+      const keys = Object.keys(entry);
+      if (
+        typeof entry.from !== 'string' ||
+        keys.some(key => !['filter', 'from', 'to'].includes(key)) ||
+        (entry.to !== undefined && typeof entry.to !== 'string') ||
+        (entry.filter !== undefined &&
+          (!Array.isArray(entry.filter) || entry.filter.some(value => typeof value !== 'string')))
+      ) {
+        throw new Error(`Invalid build manifest resources.${group}[${index}]`);
+      }
+      return {
+        ...entry,
+        from: path.resolve(path.dirname(manifestFile), entry.from),
+      };
+    });
+  };
+
+  const result = { ...config };
+  if (resources.common !== undefined) {
+    result.extraResources = [
+      ...(config.extraResources || []),
+      ...resolveResources(resources.common, 'common'),
+    ];
+  }
+  for (const platform of ['linux', 'mac', 'win']) {
+    if (resources[platform] === undefined) continue;
+    result[platform] = {
+      ...config[platform],
+      extraResources: [
+        ...(config[platform]?.extraResources || []),
+        ...resolveResources(resources[platform], platform),
+      ],
+    };
+  }
+  return result;
+}
+
 function applyBuildTargets(config, manifest) {
   const targets = manifest.targets;
   if (targets === undefined) {
@@ -122,6 +176,7 @@ function applyProductMetadata(config, manifest) {
 }
 
 module.exports = {
+  applyBuildResources,
   applyBuildTargets,
   applyPlatformMetadata,
   applyProductMetadata,
