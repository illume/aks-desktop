 app/scripts/build-manifest.js       | 32 +++++++++++++++++++++++++++
 3 files changed, 72 insertions(+), 15 deletions(-)

diff --git a/app/electron-builder.config.js b/app/electron-builder.config.js
index a7dcd0038..7087cf192 100644
--- a/app/electron-builder.config.js
+++ b/app/electron-builder.config.js
@@ -3,6 +3,7 @@
 const packageJson = require('./package.json');
 const path = require('node:path');
 const {
+  applyBuildTargets,
   applyPlatformMetadata,
   applyProductMetadata,
   DEFAULT_MANIFEST_FILE,
@@ -15,22 +16,25 @@ const defaultManifest = path.resolve(DEFAULT_MANIFEST_FILE);
 
 const manifest = loadBuildManifest(manifestFile);
 
-module.exports = applyPlatformMetadata(
-  applyProductMetadata(
-    {
-      ...packageJson.build,
-      extraResources: packageJson.build.extraResources.map(resource => {
-        if (path.resolve(__dirname, resource.from) !== defaultManifest) {
-          return resource;
-        }
+module.exports = applyBuildTargets(
+  applyPlatformMetadata(
+    applyProductMetadata(
+      {
+        ...packageJson.build,
+        extraResources: packageJson.build.extraResources.map(resource => {
+          if (path.resolve(__dirname, resource.from) !== defaultManifest) {
+            return resource;
+          }
 
-        return {
-          ...resource,
-          from: manifestFile,
-          to: 'app-build-manifest.json',
-        };
-      }),
-    },
+          return {
+            ...resource,
+            from: manifestFile,
+            to: 'app-build-manifest.json',
+          };
+        }),
+      },
+      manifest
+    ),
     manifest
   ),
   manifest
diff --git a/app/electron/build-manifest.test.ts b/app/electron/build-manifest.test.ts
index 0aaa363b3..2a081a8c1 100644
--- a/app/electron/build-manifest.test.ts
+++ b/app/electron/build-manifest.test.ts
@@ -24,6 +24,7 @@ import { afterEach, describe, expect, it } from 'vitest';
 
 const require = createRequire(import.meta.url);
 const {
+  applyBuildTargets,
   applyPlatformMetadata,
   applyProductMetadata,
   DEFAULT_MANIFEST_FILE,
@@ -83,6 +84,26 @@ describe('build manifest selection', () => {
   });
 });
 
+describe('build targets', () => {
+  it('replaces platform targets without changing other platform settings', () => {
+    expect(
+      applyBuildTargets(
+        { mac: { hardenedRuntime: true, target: ['zip'] } },
+        { targets: { mac: [{ target: 'dmg', arch: ['arm64'] }] } }
+      )
+    ).toEqual({
+      mac: { hardenedRuntime: true, target: [{ target: 'dmg', arch: ['arm64'] }] },
+    });
+  });
+
+  it('rejects unknown architectures and empty target sets', () => {
+    expect(() => applyBuildTargets({}, { targets: { mac: [] } })).toThrow('non-empty array');
+    expect(() =>
+      applyBuildTargets({}, { targets: { mac: [{ target: 'dmg', arch: ['mips'] }] } })
+    ).toThrow('Invalid build manifest architecture for mac');
+  });
+});
+
 describe('platform metadata', () => {
   it('overrides only product-facing platform fields', () => {
     const defaults = { linux: { category: 'Network', productName: 'Headlamp' } };
diff --git a/app/scripts/build-manifest.js b/app/scripts/build-manifest.js
index 2f061b640..3f6e69d1c 100644
--- a/app/scripts/build-manifest.js
+++ b/app/scripts/build-manifest.js
@@ -14,6 +14,37 @@ function loadBuildManifest(manifestFile = resolveBuildManifestPath()) {
   return JSON.parse(fs.readFileSync(manifestFile, 'utf8'));
 }
 
+function applyBuildTargets(config, manifest) {
+  const targets = manifest.targets;
+  if (targets === undefined) {
+    return config;
+  }
+  if (!targets || typeof targets !== 'object' || Array.isArray(targets)) {
+    throw new Error('Build manifest targets must be an object');
+  }
+
+  const architectures = new Set(['arm64', 'armv7l', 'ia32', 'universal', 'x64']);
+  const result = { ...config };
+  for (const platform of ['linux', 'mac', 'win']) {
+    const platformTargets = targets[platform];
+    if (platformTargets === undefined) continue;
+    if (!Array.isArray(platformTargets) || platformTargets.length === 0) {
+      throw new Error(`Build manifest targets.${platform} must be a non-empty array`);
+    }
+    for (const target of platformTargets) {
+      if (typeof target === 'string') continue;
+      if (!target || typeof target.target !== 'string' || !Array.isArray(target.arch)) {
+        throw new Error(`Invalid build manifest target for ${platform}`);
+      }
+      if (target.arch.length === 0 || target.arch.some(arch => !architectures.has(arch))) {
+        throw new Error(`Invalid build manifest architecture for ${platform}`);
+      }
+    }
+    result[platform] = { ...config[platform], target: platformTargets };
+  }
+  return result;
+}
+
 function applyPlatformMetadata(config, manifest) {
   const platforms = manifest.platforms;
   if (platforms === undefined) {
@@ -91,6 +122,7 @@ function applyProductMetadata(config, manifest) {
 }
 
 module.exports = {
+  applyBuildTargets,
   applyPlatformMetadata,
   applyProductMetadata,
   DEFAULT_MANIFEST_FILE,
