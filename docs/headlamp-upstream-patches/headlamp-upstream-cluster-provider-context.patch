+export function resolveKubeconfigPaths(
+  kubeconfigArgument?: string,
+  environment: NodeJS.ProcessEnv = process.env,
+  homeDirectory: string = os.homedir()
+): string[] {
+  let configuredPaths: string[] | undefined;
+  if (typeof kubeconfigArgument === 'string' && kubeconfigArgument.length > 0) {
+    configuredPaths = [kubeconfigArgument];
+  } else if (environment.HEADLAMP_CONFIG_KUBECONFIG) {
+    configuredPaths = [environment.HEADLAMP_CONFIG_KUBECONFIG];
+  } else {
+    configuredPaths = environment.KUBECONFIG?.split(path.delimiter)
+      .map(candidate => candidate.trim())
+      .filter(Boolean);
+  }
+  const paths =
+    configuredPaths && configuredPaths.length > 0
+      ? configuredPaths.map(candidate => path.resolve(candidate))
+      : [path.join(homeDirectory, '.kube', 'config')];
+  return [...new Set(paths)];
+}
+
 export function setupClusterProviderHandlers(
   mainWindow: BrowserWindow,
   ipcMain: IpcMain,
-  getAuthorizedProviders?: () => ReadonlyMap<string, ReadonlySet<string>>
+  getAuthorizedProviders?: () => ReadonlyMap<string, ReadonlySet<string>>,
+  getContext: () => ClusterProviderContext | Promise<ClusterProviderContext> = () => ({
+    kubeconfigPaths: resolveKubeconfigPaths(),
+  })
 ): void {
   let registrationAllowed = true;
   let providerByCapability = new Map<string, string>();
@@ -154,7 +187,7 @@ export function setupClusterProviderHandlers(
