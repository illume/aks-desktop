+import { describe, expect, it } from 'vitest';
+import yaml from 'yaml';
+import { addAzKubeloginToKubeconfig } from './aks-cluster';
+
+const kubeconfig = yaml.stringify({
+  users: [
+    {
+      name: 'cluster-user',
+      user: {
+        'auth-provider': { name: 'azure' },
+        token: 'old-token',
+      },
+    },
+  ],
+});
+
+describe('addAzKubeloginToKubeconfig', () => {
+  it('uses only digest-verified external tool paths', () => {
+    const result = yaml.parse(
+      addAzKubeloginToKubeconfig(
+        kubeconfig,
+        new Map([
+          ['azure-cli', '/resources/az'],
+          ['python', '/resources/python'],
+          ['az-kubelogin', '/resources/az-kubelogin.py'],
+        ])
+      )
+    );
+
+    expect(result.users[0].user).toEqual({
+      exec: {
+        apiVersion: 'client.authentication.k8s.io/v1beta1',
+        command: '/resources/python',
+        args: ['/resources/az-kubelogin.py', '--server-id', '6dae42f8-4368-4678-94ff-3960e28e3630'],
+        env: [{ name: 'AZ_CLI_PATH', value: '/resources/az' }],
+        provideClusterInfo: false,
+      },
+    });
+  });
+
+  it('fails closed when a required tool was not verified', () => {
+    expect(() => addAzKubeloginToKubeconfig(kubeconfig, new Map())).toThrow(
+      'Required external tool is unavailable: python'
+    );
+  });
+});
