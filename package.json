{
  "name": "aks-desktop-monorepo",
  "version": "0.9.0",
  "description": "AKS desktop - Headlamp Plugin Monorepo",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=12.0.0"
  },
  "scripts": {
    "build": "npm run headlamp:install && npm run headlamp:assemble && cross-env HEADLAMP_BUILD_MANIFEST=.aks-desktop/product-manifest.json npm --prefix node_modules/@headlamp-k8s/headlamp-source run build:app",
    "build:linux": "npm run headlamp:install && npm run headlamp:assemble && cross-env HEADLAMP_BUILD_MANIFEST=.aks-desktop/product-manifest.json npm --prefix node_modules/@headlamp-k8s/headlamp-source run build:app:linux",
    "build:mac": "npm run headlamp:install && npm run headlamp:assemble && cross-env HEADLAMP_BUILD_MANIFEST=.aks-desktop/product-manifest.json npm --prefix node_modules/@headlamp-k8s/headlamp-source run build:app:mac",
    "build:win": "npm run headlamp:install && npm run headlamp:assemble && cross-env HEADLAMP_BUILD_MANIFEST=.aks-desktop/product-manifest.json npm --prefix node_modules/@headlamp-k8s/headlamp-source run build:app:win",
    "build:win-ci": "npm run build:win",
    "build:unpacked": "npm run headlamp:install && npm run headlamp:assemble && cross-env HEADLAMP_BUILD_MANIFEST=.aks-desktop/product-manifest.json npm --prefix node_modules/@headlamp-k8s/headlamp-source run build:app:unpacked",
    "build:unpacked:linux": "npm run build:unpacked",
    "build:unpacked:mac": "npm run build:unpacked",
    "build:unpacked:win": "npm run build:unpacked",
    "build:container": "npm run headlamp:assemble && cross-env HEADLAMP_BUILD_MANIFEST=.aks-desktop/product-manifest.json npm --prefix node_modules/@headlamp-k8s/headlamp-source run build:container",
    "test:build": "tsx --test build/*.test.ts",
    "test:headlamp-package": "tsx --test build/headlamp-package.test.ts",
    "test:headlamp-patches": "npm patch ls && npm run test:headlamp-package",
    "test:post-build": "tsx ./build/verify-bundled-tools.ts",
    "test:distribution": "npm run test:post-build && npm run headlamp:smoke --",
    "plugin:setup": "npm --prefix node_modules/@headlamp-k8s/headlamp-source run bundle:plugins",
    "plugin:install": "cd plugins/aks-desktop && npm install",
    "plugin:build": "cd plugins/aks-desktop && npm run build",
    "plugin:start": "cd plugins/aks-desktop && npm start",
    "plugin:test": "cd plugins/aks-desktop && npm test",
    "plugin:lint": "cd plugins/aks-desktop && npm run lint",
    "plugin:test:all": "cd plugins/aks-desktop && npm run test:all",
    "plugin:format": "cd plugins/aks-desktop && npm run format",
    "plugin:package": "cd plugins/aks-desktop && npm run package",
    "ai-assistant:install": "cd plugins/ai-assistant && npm install",
    "ai-assistant:build": "cd plugins/ai-assistant && npm run build",
    "ai-assistant:start": "cd plugins/ai-assistant && npm start",
    "ai-assistant:test": "cd plugins/ai-assistant && npm test",
    "ai-assistant:lint": "cd plugins/ai-assistant && npm run lint",
    "ai-assistant:format": "cd plugins/ai-assistant && npm run format",
    "headlamp:manifest": "tsx ./build/generate-headlamp-manifest.ts",
    "headlamp:assemble": "npm run headlamp:tools && npm run plugin:setup && npm run headlamp:manifest",
    "headlamp:doctor": "npm run test:headlamp-package && tsx ./build/generate-headlamp-manifest.ts --check",
    "headlamp:smoke": "npm --prefix node_modules/@headlamp-k8s/headlamp-source run smoke:app --",
    "headlamp:tools": "tsx ./build/setup-external-tools.ts",
    "headlamp:install": "npm --prefix node_modules/@headlamp-k8s/headlamp-source run install:all",
    "headlamp:build": "npm --prefix node_modules/@headlamp-k8s/headlamp-source run build",
    "install:all": "npm run headlamp:install && npm run plugin:install && npm run ai-assistant:install",
    "build:all": "npm run headlamp:build && npm run plugin:build && npm run ai-assistant:build",
    "predev": "npm run headlamp:install && npm run headlamp:assemble",
    "dev": "cross-env HEADLAMP_BUILD_MANIFEST=.aks-desktop/product-manifest.json concurrently --kill-others --names \"PLUGIN,AI-ASSISTANT,BACKEND,FRONTEND,APP\" -c \"cyan,blue,green,yellow,magenta\" \"npm run plugin:start\" \"npm run ai-assistant:start\" \"npm --prefix node_modules/@headlamp-k8s/headlamp-source run start:backend\" \"npm --prefix node_modules/@headlamp-k8s/headlamp-source run start:frontend\" \"npm --prefix node_modules/@headlamp-k8s/headlamp-source run start:app\"",
    "prepare": "husky",
    "knip": "knip",
    "i18n:collect": "node Localize/translation-manager.mjs collect",
    "i18n:distribute": "node Localize/translation-manager.mjs distribute"
  },
  "config": {
    "externalTools": {
      "python": {
        "linux": {
          "url": "https://github.com/astral-sh/python-build-standalone/releases/download/20250723/cpython-3.10.18+20250723-x86_64_v3-unknown-linux-gnu-install_only_stripped.tar.gz",
          "checksum": "b712e37fd4f50243afae019f0c325568129550b66598addb6dd9685d36b4625f"
        },
        "darwin": {
          "url": "https://github.com/astral-sh/python-build-standalone/releases/download/20251028/cpython-3.10.19+20251028-x86_64-apple-darwin-install_only_stripped.tar.gz",
          "checksum": "ff636e82637a7768c499921188222322369584d1b6a2e85a898aba1e263d69f2"
        }
      },
      "azureCli": {
        "version": "2.78.0",
        "extensions": [
          "aks-preview",
          "resource-graph",
          "alertsmanagement"
        ],
        "win32": {
          "checksum": "37918233a753986e698ab3b2993b97a17b4458d24c2af94c05be5fa9042874ed"
        }
      }
    }
  },
  "headlamp": {
    "product": {
      "name": "aks-desktop",
      "productName": "AKS Desktop",
      "appId": "com.microsoft.aksdesktop",
      "artifactName": "aks-desktop-${version}-${os}-${arch}.${ext}",
      "protocols": {
        "name": "AKS Desktop",
        "schemes": [
          "aks-desktop"
        ]
      }
    },
    "checkForUpdates": false,
    "legalDocuments": [
      {
        "id": "license",
        "title": "AKS Desktop license",
        "file": "AKS_DESKTOP_LICENSE.txt"
      },
      {
        "id": "notices",
        "title": "AKS Desktop notices",
        "file": "AKS_DESKTOP_NOTICE.md"
      }
    ],
    "platforms": {
      "linux": {
        "executableName": "aks-desktop"
      },
      "mac": {
        "appId": "com.microsoft.aksdesktop",
        "executableName": "aks-desktop"
      },
      "win": {
        "executableName": "aks-desktop"
      }
    },
    "plugins": [
      {
        "name": "aks-desktop",
        "packageName": "aks-desktop",
        "source": "plugins/aks-desktop",
        "enabledByDefault": true,
        "capabilities": {
          "runCommands": [
            {
              "tool": "az",
              "args": [
                "account"
              ],
              "allowTrailingArgs": true
            },
            {
              "tool": "az",
              "args": [
                "acr"
              ],
              "allowTrailingArgs": true
            },
            {
              "tool": "az",
              "args": [
                "aks"
              ],
              "allowTrailingArgs": true
            },
            {
              "tool": "az",
              "args": [
                "alerts-management"
              ],
              "allowTrailingArgs": true
            },
            {
              "tool": "az",
              "args": [
                "config"
              ],
              "allowTrailingArgs": true
            },
            {
              "tool": "az",
              "args": [
                "connectedk8s"
              ],
              "allowTrailingArgs": true
            },
            {
              "tool": "az",
              "args": [
                "extension"
              ],
              "allowTrailingArgs": true
            },
            {
              "tool": "az",
              "args": [
                "feature"
              ],
              "allowTrailingArgs": true
            },
            {
              "tool": "az",
              "args": [
                "graph"
              ],
              "allowTrailingArgs": true
            },
            {
              "tool": "az",
              "args": [
                "group"
              ],
              "allowTrailingArgs": true
            },
            {
              "tool": "az",
              "args": [
                "login"
              ],
              "allowTrailingArgs": true
            },
            {
              "tool": "az",
              "args": [
                "logout"
              ],
              "allowTrailingArgs": true
            },
            {
              "tool": "az",
              "args": [
                "monitor"
              ],
              "allowTrailingArgs": true
            },
            {
              "tool": "az",
              "args": [
                "role"
              ],
              "allowTrailingArgs": true
            },
            {
              "tool": "az",
              "args": [
                "version"
              ],
              "allowTrailingArgs": true
            },
            {
              "tool": "az",
              "args": [
                "vm"
              ],
              "allowTrailingArgs": true
            },
            {
              "command": "kubectl",
              "args": [
                "config"
              ],
              "allowTrailingArgs": true
            }
          ]
        }
      },
      {
        "name": "ai-assistant",
        "packageName": "@headlamp-k8s/ai-assistant",
        "source": "plugins/ai-assistant",
        "enabledByDefault": true
      },
      {
        "name": "insights-plugin",
        "packageName": "insights-plugin",
        "source": "plugins/insights-plugin",
        "enabledByDefault": true
      }
    ]
  },
  "devDependencies": {
    "@headlamp-k8s/headlamp-source": "0.44.0-main.99a230be",
    "@types/node": "^26.1.1",
    "concurrently": "^9.1.2",
    "cross-env": "10.1.0",
    "husky": "^9.0.0",
    "knip": "^6.24.0",
    "lint-staged": "^17.0.8",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "patchedDependencies": {
    "@headlamp-k8s/headlamp-source@0.44.0-main.99a230be": "build/patches/headlamp-source@0.44.0-main.99a230be.patch"
  },
  "lint-staged": {
    "plugins/aks-desktop/**/*.{js,jsx,ts,tsx}": [
      "node .husky/lint-plugin.js"
    ],
    "plugins/aks-desktop/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "node .husky/format-plugin.js"
    ],
    "plugins/ai-assistant/**/*.{js,jsx,ts,tsx}": [
      "node .husky/lint-ai-assistant.js"
    ],
    "plugins/ai-assistant/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "node .husky/format-ai-assistant.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Azure/aks-desktop.git"
  },
  "keywords": [
    "kubernetes",
    "aks",
    "azure",
    "headlamp",
    "plugin"
  ],
  "author": "Microsoft",
  "license": "MIT",
  "allowScripts": {
    "esbuild": false
  }
}
