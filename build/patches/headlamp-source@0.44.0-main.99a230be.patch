+import { describe, expect, it } from 'vitest';
+import { getProtocolScheme, isProtocolUrl, readProtocolScheme } from './protocol';
+
+describe('getProtocolScheme', () => {
+  it('returns the protocol persisted in product metadata', () => {
+    expect(getProtocolScheme({ protocolScheme: 'My-Desktop' })).toBe('my-desktop');
+  });
+
+  it.each([{}, null, { protocolScheme: 1 }])(
+    'falls back for product metadata without a protocol',
+    buildManifest => {
+      expect(getProtocolScheme(buildManifest)).toBe('headlamp');
+    }
+  );
+
+  it('falls back for an invalid protocol', () => {
+    expect(getProtocolScheme({ protocolScheme: 'not a scheme' })).toBe('headlamp');
+  });
+});
+
+describe('readProtocolScheme', () => {
+  it('falls back when product metadata cannot be read', () => {
+    expect(readProtocolScheme('/path/that/does/not/exist')).toBe('headlamp');
+  });
+});
+
+describe('isProtocolUrl', () => {
+  it('accepts URLs for the configured protocol', () => {
+    expect(isProtocolUrl('my-desktop://cluster?name=local', 'my-desktop')).toBe(true);
+  });
+
+  it('rejects malformed URLs and other protocols', () => {
+    expect(isProtocolUrl('not a URL', 'my-desktop')).toBe(false);
+    expect(isProtocolUrl('headlamp://cluster', 'my-desktop')).toBe(false);
+  });
+});
