diff --git a/source/frontend/src/plugin/clusterProviderCapabilities.ts b/source/frontend/src/plugin/clusterProviderCapabilities.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3d6137566811d9ba4e118defef77a163c5859e35
