+
+import { describe, expect, it } from 'vitest';
+import { getProductErrorContent } from './getProductErrorContent';
+
+describe('getProductErrorContent', () => {
+  it('returns distribution error-page content', () => {
+    expect(
+      getProductErrorContent('error', {
+        REACT_APP_HEADLAMP_ERROR_PAGE_TITLE: ' Product error ',
+        REACT_APP_HEADLAMP_ERROR_PAGE_GRAPHIC: '/product/error.svg',
+      })
+    ).toEqual({
+      title: 'Product error',
+      graphic: '/product/error.svg',
+    });
+  });
+
+  it('keeps not-found content independent', () => {
+    expect(
+      getProductErrorContent('notFound', {
+        REACT_APP_HEADLAMP_ERROR_PAGE_TITLE: 'Wrong page',
+        REACT_APP_HEADLAMP_NOT_FOUND_PAGE_TITLE: 'Page missing',
+      })
+    ).toEqual({
+      title: 'Page missing',
+      graphic: undefined,
+    });
+  });
+
+  it('ignores empty and non-string values', () => {
+    expect(
+      getProductErrorContent('error', {
+        REACT_APP_HEADLAMP_ERROR_PAGE_TITLE: '  ',
+        REACT_APP_HEADLAMP_ERROR_PAGE_GRAPHIC: 42,
+      })
+    ).toEqual({
+      title: undefined,
+      graphic: undefined,
+    });
+  });
+});
