+module.exports = {
+  applyBuildResources,
+  applyBuildTargets,
+  applyPlatformMetadata,
+  applyProductMetadata,
+  DEFAULT_MANIFEST_FILE,
+  loadBuildManifest,
+  resolveBuildManifestPath,
+  verifyPackagedResources,
+};
