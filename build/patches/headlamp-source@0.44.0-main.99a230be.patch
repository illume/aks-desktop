+
+import crypto from 'node:crypto';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { resolveExternalTools } from './external-tools';
+
+describe('resolveExternalTools', () => {
+  let directory: string;
+  let resourcesPath: string;
+  let executablePath: string;
+  let digest: string;
+
+  beforeEach(() => {
+    directory = fs.mkdtempSync(path.join(os.tmpdir(), 'headlamp-external-tools-'));
+    resourcesPath = path.join(directory, 'resources');
+    executablePath = path.join(resourcesPath, 'bin', 'example');
+    fs.mkdirSync(path.dirname(executablePath), { recursive: true });
+    fs.writeFileSync(executablePath, 'verified executable');
+    digest = crypto.createHash('sha256').update(fs.readFileSync(executablePath)).digest('hex');
+  });
+
+  afterEach(() => {
+    fs.rmSync(directory, { recursive: true, force: true });
+  });
+
+  function manifest(toolPath = 'bin/example', sha256 = digest) {
+    return {
+      'external-tools': [
+        {
+          id: 'example-cli',
+          platforms: {
+            linux: { path: toolPath, sha256 },
+          },
+        },
+      ],
+    };
+  }
+
+  it('resolves a digest-verified executable for the current product', () => {
+    expect(resolveExternalTools(manifest(), resourcesPath, 'linux')).toEqual(
+      new Map([['example-cli', executablePath]])
+    );
+  });
+
+  it('rejects a tool whose digest does not match', () => {
+    expect(
+      resolveExternalTools(manifest('bin/example', '0'.repeat(64)), resourcesPath, 'linux')
+    ).toEqual(new Map());
+  });
+
+  it('rejects paths outside the product resources directory', () => {
+    const outsidePath = path.join(directory, 'outside');
+    fs.writeFileSync(outsidePath, 'verified executable');
+    const outsideDigest = crypto
+      .createHash('sha256')
+      .update(fs.readFileSync(outsidePath))
+      .digest('hex');
+
+    expect(
+      resolveExternalTools(manifest('../outside', outsideDigest), resourcesPath, 'linux')
+    ).toEqual(new Map());
+  });
+
+  it('rejects symlinks that escape the product resources directory', () => {
+    const outsidePath = path.join(directory, 'outside');
+    const symlinkPath = path.join(resourcesPath, 'bin', 'linked');
+    fs.writeFileSync(outsidePath, 'verified executable');
+    fs.symlinkSync(outsidePath, symlinkPath);
+    const outsideDigest = crypto
+      .createHash('sha256')
+      .update(fs.readFileSync(outsidePath))
+      .digest('hex');
+
+    expect(
+      resolveExternalTools(manifest('bin/linked', outsideDigest), resourcesPath, 'linux')
+    ).toEqual(new Map());
+  });
+
+  it('uses only the selected platform declaration', () => {
+    expect(resolveExternalTools(manifest(), resourcesPath, 'win32')).toEqual(new Map());
+  });
+});
