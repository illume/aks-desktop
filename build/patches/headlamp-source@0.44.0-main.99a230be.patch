diff --git a/source/app/electron-builder.config.js b/source/app/electron-builder.config.js
new file mode 100644
index 0000000000000000000000000000000000000000..d07eaf100caf058b221e46ee031368e9b3e465fd
--- /dev/null
+++ b/source/app/electron-builder.config.js
@@ -0,0 +1,46 @@
+'use strict';
+
+const packageJson = require('./package.json');
+const path = require('node:path');
+const {
+  applyBuildResources,
+  applyBuildTargets,
+  applyPlatformMetadata,
+  applyProductMetadata,
+  DEFAULT_MANIFEST_FILE,
+  loadBuildManifest,
+  resolveBuildManifestPath,
+} = require('./scripts/build-manifest');
+
+const manifestFile = resolveBuildManifestPath();
+const defaultManifest = path.resolve(DEFAULT_MANIFEST_FILE);
+
+const manifest = loadBuildManifest(manifestFile);
+
+module.exports = applyBuildResources(
+  applyBuildTargets(
+    applyPlatformMetadata(
+      applyProductMetadata(
+        {
+          ...packageJson.build,
+          extraResources: packageJson.build.extraResources.map(resource => {
+            if (path.resolve(__dirname, resource.from) !== defaultManifest) {
+              return resource;
+            }
+
+            return {
+              ...resource,
+              from: manifestFile,
+              to: 'app-build-manifest.json',
+            };
+          }),
+        },
+        manifest
+      ),
+      manifest
+    ),
+    manifest
+  ),
+  manifest,
+  manifestFile
+);
diff --git a/source/app/electron/build-manifest.test.ts b/source/app/electron/build-manifest.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..eb55a7ae31c85561e3110b1a41ab24cf84f3b36d
--- /dev/null
+++ b/source/app/electron/build-manifest.test.ts
@@ -0,0 +1,324 @@
+/*
