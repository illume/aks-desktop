+/** Merges cached shell changes without discarding later process environment updates. */
+export function mergeShellEnvironment(
+  currentEnvironment: NodeJS.ProcessEnv,
+  shellOverrides: NodeJS.ProcessEnv,
+  baselineEnvironment: NodeJS.ProcessEnv
+): NodeJS.ProcessEnv {
+  const mergedEnvironment = { ...currentEnvironment, ...shellOverrides };
+  for (const key of new Set([
+    ...Object.keys(baselineEnvironment),
+    ...Object.keys(currentEnvironment),
+  ])) {
+    if (currentEnvironment[key] !== baselineEnvironment[key]) {
+      if (currentEnvironment[key] === undefined) {
+        delete mergedEnvironment[key];
+      } else {
+        mergedEnvironment[key] = currentEnvironment[key];
+      }
+    }
+  }
+
+  if (
+    currentEnvironment.PATH !== baselineEnvironment.PATH &&
+    currentEnvironment.PATH &&
+    shellOverrides.PATH
+  ) {
+    const baselineEntries = new Set((baselineEnvironment.PATH ?? '').split(path.delimiter));
+    const currentEntries = currentEnvironment.PATH.split(path.delimiter);
+    const liveEntries = currentEntries.filter(entry => !baselineEntries.has(entry));
+    mergedEnvironment.PATH = [
+      ...new Set([...liveEntries, ...shellOverrides.PATH.split(path.delimiter), ...currentEntries]),
+    ].join(path.delimiter);
+  }
+
+  return mergedEnvironment;
+}
