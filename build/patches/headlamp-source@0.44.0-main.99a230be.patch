+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { afterEach, describe, expect, it } from 'vitest';
+import {
+  commandScopeKey,
+  loadPluginCapabilityPolicy,
+  resolvePluginCapabilityPolicy,
+} from './plugin-capability-policy';
+
+const temporaryDirectories: string[] = [];
+
+afterEach(() => {
+  temporaryDirectories
+    .splice(0)
+    .forEach(directory => fs.rmSync(directory, { recursive: true, force: true }));
+});
+
+describe('product plugin capability policy', () => {
+  it('indexes product-authorized capabilities by package identity', () => {
+    const commandScope = { command: 'kubectl', args: ['get'], allowTrailingArgs: true };
+    const policy = resolvePluginCapabilityPolicy({
+      plugins: [
+        {
+          packageName: '@example/plugin',
+          capabilities: {
+            runCommands: [commandScope],
+            clusterProviders: ['example.cluster'],
+          },
+        },
+      ],
+    });
+
+    expect(policy.commandScopes.get('@example/plugin')).toEqual(
+      new Set([commandScopeKey(commandScope)])
+    );
+    expect(policy.clusterProviders.get('@example/plugin')).toEqual(new Set(['example.cluster']));
+  });
+
+  it('fails closed for duplicate package identities and malformed declarations', () => {
+    const policy = resolvePluginCapabilityPolicy({
+      plugins: [
+        { packageName: '@example/plugin', capabilities: { runCommands: [] } },
+        {
+          packageName: '@example/plugin',
+          capabilities: { runCommands: [{ command: 'kubectl', args: [] }] },
+        },
+        {
+          packageName: '../plugin',
+          capabilities: { clusterProviders: ['example.cluster'] },
+        },
+      ],
+    });
+
+    expect(policy.commandScopes.size).toBe(0);
+    expect(policy.clusterProviders.size).toBe(0);
+  });
+
+  it('fails closed when the product manifest cannot be loaded', () => {
+    const policy = loadPluginCapabilityPolicy('/missing/app-build-manifest.json');
+
+    expect(policy.commandScopes.size).toBe(0);
+    expect(policy.clusterProviders.size).toBe(0);
+  });
+
+  it('normalizes omitted command arguments', () => {
+    expect(commandScopeKey({ command: 'kubectl' })).toBe(
+      commandScopeKey({ command: 'kubectl', args: [] })
+    );
+    expect(commandScopeKey({ command: 'kubectl', args: null })).toBeUndefined();
+  });
+
+  it('denies capabilities when an untrusted plugin shadows the package', () => {
+    const root = fs.mkdtempSync(path.join(os.tmpdir(), 'headlamp-policy-'));
+    temporaryDirectories.push(root);
+    const manifestPath = path.join(root, 'app-build-manifest.json');
+    const userPlugins = path.join(root, 'user-plugins');
+    fs.mkdirSync(path.join(userPlugins, 'override'), { recursive: true });
+    fs.writeFileSync(
+      manifestPath,
+      JSON.stringify({
+        plugins: [
+          {
+            packageName: '@example/plugin',
+            capabilities: {
+              runCommands: [{ command: 'kubectl' }],
+              clusterProviders: ['example.cluster'],
+            },
+          },
+        ],
+      })
+    );
+    fs.writeFileSync(
+      path.join(userPlugins, 'override', 'package.json'),
+      JSON.stringify({ name: '@example/plugin' })
+    );
+
+    const policy = loadPluginCapabilityPolicy(manifestPath, [userPlugins]);
+
+    expect(policy.commandScopes.size).toBe(0);
+    expect(policy.clusterProviders.size).toBe(0);
+  });
+});
