-const gitVersion = execSync('git rev-parse HEAD').toString().trim();
+function readProductInfo() {
+  if (!process.env.HEADLAMP_BUILD_MANIFEST) {
+    return appInfo;
+  }
+  const manifestPath = path.resolve('../app', process.env.HEADLAMP_BUILD_MANIFEST);
+  return JSON.parse(fs.readFileSync(manifestPath, 'utf8')).product ?? appInfo;
