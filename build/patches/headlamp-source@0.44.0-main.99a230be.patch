diff --git a/source/app/scripts/build-manifest.js b/source/app/scripts/build-manifest.js
new file mode 100644
index 0000000000000000000000000000000000000000..f84723ddd81b6f7dbde984f0ecc404410fb617bc
--- /dev/null
+++ b/source/app/scripts/build-manifest.js
@@ -0,0 +1,235 @@
+'use strict';
+
+const crypto = require('node:crypto');
+const fs = require('node:fs');
+const path = require('node:path');
+
+const DEFAULT_MANIFEST_FILE = path.join(__dirname, '../app-build-manifest.json');
+
+function resolveBuildManifestPath(env = process.env, cwd = process.cwd()) {
+  const configuredPath = env.HEADLAMP_BUILD_MANIFEST;
+  return configuredPath ? path.resolve(cwd, configuredPath) : DEFAULT_MANIFEST_FILE;
+}
+
+function loadBuildManifest(manifestFile = resolveBuildManifestPath()) {
+  return JSON.parse(fs.readFileSync(manifestFile, 'utf8'));
+}
+
+function verifyPackagedResources(resourcesDirectory, manifest, platform) {
+  const verification = manifest.verify;
+  if (verification === undefined) {
+    return;
+  }
+  if (!Array.isArray(verification)) {
+    throw new Error('Build manifest verify must be an array');
+  }
+
+  const platformName = { darwin: 'mac', mas: 'mac', win32: 'win' }[platform] || platform;
+  const root = path.resolve(resourcesDirectory);
+  for (const [index, entry] of verification.entries()) {
+    if (
+      !entry ||
+      typeof entry.path !== 'string' ||
+      typeof entry.sha256 !== 'string' ||
+      (entry.platforms !== undefined &&
+        (!Array.isArray(entry.platforms) ||
+          entry.platforms.some(value => !['linux', 'mac', 'win'].includes(value))))
+    ) {
+      throw new Error(`Invalid build manifest verify[${index}]`);
+    }
+    if (entry.platforms && !entry.platforms.includes(platformName)) {
+      continue;
+    }
+    if (!/^[a-f0-9]{64}$/i.test(entry.sha256)) {
+      throw new Error(`Invalid SHA-256 for packaged resource ${entry.path}`);
+    }
+
+    const resource = path.resolve(root, entry.path);
+    if (resource !== root && !resource.startsWith(`${root}${path.sep}`)) {
+      throw new Error(`Packaged resource escapes the resources directory: ${entry.path}`);
+    }
+    const stat = fs.lstatSync(resource);
+    if (!stat.isFile() || stat.isSymbolicLink()) {
+      throw new Error(`Packaged resource is not a regular file: ${entry.path}`);
+    }
+    const actualDigest = crypto
+      .createHash('sha256')
+      .update(fs.readFileSync(resource))
+      .digest('hex');
+    if (actualDigest.toLowerCase() !== entry.sha256.toLowerCase()) {
+      throw new Error(`SHA-256 mismatch for packaged resource ${entry.path}`);
+    }
+  }
+}
+
+function applyBuildResources(config, manifest, manifestFile = resolveBuildManifestPath()) {
+  const resources = manifest.resources;
+  if (resources === undefined) {
+    return config;
+  }
+  if (!resources || typeof resources !== 'object' || Array.isArray(resources)) {
+    throw new Error('Build manifest resources must be an object');
+  }
+
+  const resolveResources = (entries, group) => {
+    if (!Array.isArray(entries)) {
+      throw new Error(`Build manifest resources.${group} must be an array`);
+    }
+    return entries.map((entry, index) => {
+      if (!entry || typeof entry !== 'object' || Array.isArray(entry)) {
+        throw new Error(`Invalid build manifest resources.${group}[${index}]`);
+      }
+      const keys = Object.keys(entry);
+      if (
+        typeof entry.from !== 'string' ||
+        keys.some(key => !['filter', 'from', 'to'].includes(key)) ||
+        (entry.to !== undefined && typeof entry.to !== 'string') ||
+        (entry.filter !== undefined &&
+          (!Array.isArray(entry.filter) || entry.filter.some(value => typeof value !== 'string')))
+      ) {
+        throw new Error(`Invalid build manifest resources.${group}[${index}]`);
+      }
+      return {
+        ...entry,
+        from: path.resolve(path.dirname(manifestFile), entry.from),
+      };
+    });
+  };
+
+  const result = { ...config };
+  if (resources.common !== undefined) {
+    result.extraResources = [
+      ...(config.extraResources || []),
+      ...resolveResources(resources.common, 'common'),
+    ];
+  }
+  for (const platform of ['linux', 'mac', 'win']) {
+    if (resources[platform] === undefined) continue;
+    result[platform] = {
+      ...config[platform],
+      extraResources: [
+        ...(config[platform]?.extraResources || []),
+        ...resolveResources(resources[platform], platform),
+      ],
+    };
+  }
+  return result;
+}
+
+function applyBuildTargets(config, manifest) {
+  const targets = manifest.targets;
+  if (targets === undefined) {
+    return config;
+  }
+  if (!targets || typeof targets !== 'object' || Array.isArray(targets)) {
+    throw new Error('Build manifest targets must be an object');
+  }
+
+  const architectures = new Set(['arm64', 'armv7l', 'ia32', 'universal', 'x64']);
+  const result = { ...config };
+  for (const platform of ['linux', 'mac', 'win']) {
+    const platformTargets = targets[platform];
+    if (platformTargets === undefined) continue;
+    if (!Array.isArray(platformTargets) || platformTargets.length === 0) {
+      throw new Error(`Build manifest targets.${platform} must be a non-empty array`);
