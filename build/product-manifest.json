{
  "product": {
    "name": "aks-desktop",
    "productName": "AKS Desktop",
    "version": "0.9.0",
    "appId": "com.microsoft.aksdesktop",
    "artifactName": "aks-desktop-${version}-${os}-${arch}.${ext}",
    "protocols": {
      "name": "AKS Desktop",
      "schemes": ["aks-desktop"]
    }
  },
  "checkForUpdates": false,
  "legalDocuments": [
    {
      "id": "license",
      "title": "AKS Desktop license",
      "file": "AKS_DESKTOP_LICENSE.txt"
    },
    {
      "id": "notices",
      "title": "AKS Desktop notices",
      "file": "AKS_DESKTOP_NOTICE.md"
    }
  ],
  "platforms": {
    "linux": {
      "executableName": "aks-desktop"
    },
    "mac": {
      "appId": "com.microsoft.aksdesktop",
      "executableName": "aks-desktop"
    },
    "win": {
      "executableName": "aks-desktop"
    }
  },
  "plugins": [
    {
      "name": "aks-desktop",
      "packageName": "aks-desktop",
      "enabledByDefault": true,
      "capabilities": {
        "runCommands": [
          { "tool": "az", "args": ["account"], "allowTrailingArgs": true },
          { "tool": "az", "args": ["acr"], "allowTrailingArgs": true },
          { "tool": "az", "args": ["aks"], "allowTrailingArgs": true },
          { "tool": "az", "args": ["alerts-management"], "allowTrailingArgs": true },
          { "tool": "az", "args": ["config"], "allowTrailingArgs": true },
          { "tool": "az", "args": ["connectedk8s"], "allowTrailingArgs": true },
          { "tool": "az", "args": ["extension"], "allowTrailingArgs": true },
          { "tool": "az", "args": ["feature"], "allowTrailingArgs": true },
          { "tool": "az", "args": ["graph"], "allowTrailingArgs": true },
          { "tool": "az", "args": ["group"], "allowTrailingArgs": true },
          { "tool": "az", "args": ["login"], "allowTrailingArgs": true },
          { "tool": "az", "args": ["logout"], "allowTrailingArgs": true },
          { "tool": "az", "args": ["monitor"], "allowTrailingArgs": true },
          { "tool": "az", "args": ["role"], "allowTrailingArgs": true },
          { "tool": "az", "args": ["version"], "allowTrailingArgs": true },
          { "tool": "az", "args": ["vm"], "allowTrailingArgs": true },
          { "command": "kubectl", "args": ["config"], "allowTrailingArgs": true }
        ]
      }
    },
    {
      "name": "ai-assistant",
      "packageName": "@headlamp-k8s/ai-assistant",
      "enabledByDefault": true
    },
    {
      "name": "insights-plugin",
      "packageName": "insights-plugin",
      "enabledByDefault": true
    }
  ]
}
